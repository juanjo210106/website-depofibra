---
/**
 * DEPOFIBRA — HERO APROBADO. Reproduce la composición del archivo
 * depofibra-home-seo-geo-revisada.html; no la propuesta de tarjetas/categorías.
 * Las fotos Unsplash son ambientales y provisionales.
 */
const slides = [
  { image:'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=2000&q=85', title:'Depósitos de poliéster<br>para agua, riego e industria', description:'Comercializamos depósitos de poliéster reforzado con fibra de vidrio (PRFV) para almacenar agua de riego y otros usos compatibles. Explora capacidades, tipos de instalación y solicita un presupuesto con transporte para tu localidad.', action:'CONSULTAR MI DEPÓSITO', product:'Otro depósito de poliéster' },
  { image:'https://images.unsplash.com/photo-1625246333195-78d9c38ad449?auto=format&fit=crop&w=2000&q=80', title:'Depósitos verticales<br>de base plana', description:'Consulta depósitos verticales de base plana de 5.000, 10.000 y 15.000 litros. Compara el espacio de instalación, la altura, los accesos y las conexiones antes de decidir.', action:'CONSULTAR CAPACIDADES', product:'Otro depósito de poliéster' },
  { image:'https://images.unsplash.com/photo-1500651230702-0e2d8a49d4ad?auto=format&fit=crop&w=2000&q=80', title:'Fosas sépticas<br>y soluciones de saneamiento', description:'Fosas estancas, equipos con filtro biológico y sistemas de oxidación total. El modelo debe elegirse según la instalación, las necesidades de tratamiento y la documentación aplicable.', action:'CONSULTAR FOSAS', product:'Fosa séptica' },
  { image:'https://images.unsplash.com/photo-1576013551627-0cc20b96c2a7?auto=format&fit=crop&w=2000&q=80', title:'Piscinas, cubas<br>y cisternas de poliéster', description:'Piscinas prefabricadas, cubas agrícolas y cisternas de poliéster. Consulta las dimensiones, accesorios y condiciones de entrega de cada referencia.', action:'PEDIR PRESUPUESTO', product:'' }
];
---
<section class="dfh-hero" id="top" aria-label="Presentación de Depofibra" data-dfh>
  <div class="dfh-photos" aria-hidden="true">
    {slides.map((slide,i)=>(
      <div class:list={['dfh-photo',{'is-active':i===0}]} data-dfh-photo>
        <img src={slide.image} alt="" width="2000" height="1300" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'} decoding="async" />
      </div>
    ))}
  </div>
  <div class="dfh-shade" aria-hidden="true"></div>
  <div class="dfh-container">
    <div class="dfh-texts">
      {slides.map((slide,i)=>(
        <div class:list={['dfh-pane',{'is-active':i===0}]} data-dfh-pane aria-hidden={i===0?'false':'true'} inert={i!==0}>
          {i===0?<h1 class="dfh-title" set:html={slide.title}/>:<p class="dfh-title" set:html={slide.title}/>}
          <div class="dfh-bottom">
            <p class="dfh-description">{slide.description}</p>
            <button class="dfh-cta open-quote-trigger" data-product={slide.product} type="button">
              <span>{slide.action}</span>
              <span class="dfh-cta-circle" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17 17 7M7 7h10v10"/></svg></span>
            </button>
          </div>
        </div>
      ))}
    </div>
    <div class="dfh-pagination" role="group" aria-label="Seleccionar diapositiva">
      {slides.map((_,i)=><button type="button" class:list={['dfh-dot',{'is-active':i===0}]} data-dfh-dot={i} aria-label={`Diapositiva ${i+1}`} aria-pressed={i===0?'true':'false'} />)}
    </div>
  </div>
</section>
<style>
  .dfh-hero{position:relative;isolation:isolate;display:flex;align-items:flex-end;width:100%;min-height:600px;height:calc(100svh - 125px);max-height:860px;padding:112px 42px clamp(76px,11svh,120px);overflow:hidden;background:#04284a;color:#fff}
  .dfh-photos,.dfh-shade{position:absolute;inset:0;pointer-events:none}
  .dfh-photos{z-index:-2}
  .dfh-photo{position:absolute;inset:0;opacity:0;transform:scale(1.035);transition:opacity 1s ease,transform 7.5s ease-out}
  .dfh-photo.is-active{opacity:1;transform:scale(1)}
  .dfh-photo img{display:block;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center}
  .dfh-shade{z-index:-1;background:linear-gradient(180deg,rgba(0,24,51,.62) 0%,rgba(1,45,89,.18) 37%,rgba(0,20,41,.68) 72%,rgba(0,15,31,.9) 100%)}
  .dfh-container{position:relative;width:min(1320px,100%);margin-inline:auto;display:flex;align-items:flex-end;justify-content:space-between;gap:28px}
  .dfh-texts{min-width:0;flex:1}
  .dfh-pane{display:none;animation:dfh-appear .7s cubic-bezier(.16,1,.3,1) both}
  .dfh-pane.is-active{display:block}
  @keyframes dfh-appear{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
  .dfh-title{max-width:1000px;margin:0 0 24px;color:#fff;font:800 clamp(2.5rem,5.1vw,4.5rem)/1.04 var(--font-display,"Plus Jakarta Sans",sans-serif);letter-spacing:-.045em;text-shadow:0 3px 18px rgba(0,18,38,.45)}
  .dfh-bottom{display:flex;align-items:center;gap:28px;max-width:1050px}
  .dfh-description{max-width:650px;margin:0;color:rgba(255,255,255,.94);font-size:15px;line-height:1.65;text-shadow:0 1px 8px rgba(0,18,38,.65)}
  .dfh-cta{display:inline-flex;align-items:center;gap:12px;flex-shrink:0;padding:8px 9px 8px 22px;border:0;border-radius:999px;color:#01488e;background:#fff;font:800 12px/1.2 var(--font-display,"Plus Jakarta Sans",sans-serif);letter-spacing:.025em;cursor:pointer;white-space:nowrap;box-shadow:0 8px 24px rgba(0,18,38,.24);transition:transform .2s ease,background .2s ease,color .2s ease}
  .dfh-cta:hover{background:#01488e;color:#fff;transform:translateY(-2px)}
  .dfh-cta-circle{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;color:#fff;background:#01488e;transition:background .2s ease,color .2s ease,transform .25s ease}
  .dfh-cta:hover .dfh-cta-circle{background:#fff;color:#01488e;transform:rotate(45deg)}
  .dfh-pagination{display:flex;align-items:center;gap:8px;flex:0 0 auto;padding-bottom:7px}
  .dfh-dot{width:11px;height:11px;border:0;border-radius:50px;background:rgba(255,255,255,.45);cursor:pointer;transition:width .25s ease,background .25s ease}
  .dfh-dot.is-active{width:27px;background:#fff}
  .dfh-dot:focus-visible,.dfh-cta:focus-visible{outline:3px solid #70b7ff;outline-offset:4px}
  /* V37 — Hero anclado al borde inferior también en portátiles.
     El antiguo align-items:center hacía subir el bloque central aunque
     la paginación ya estuviera anclada abajo. */
  @media (min-width:900px) and (max-height:850px) {
    .dfh-hero {
      min-height: max(480px, calc(100svh - 125px));
      height: auto;
      max-height: none;
      align-items: flex-end;
      padding: 54px 36px clamp(72px, 9svh, 92px);
    }
    .dfh-container { position: static; align-items: flex-end; }
    .dfh-pagination {
      position: absolute;
      right: max(36px, calc((100vw - 1320px) / 2));
      bottom: clamp(52px, 8svh, 75px);
    }
    .dfh-title {
      font-size: clamp(2.5rem, 4.15vw, 3.85rem);
      margin-bottom: 18px;
    }
    .dfh-description { font-size: 14px; line-height: 1.6; }
  }
  /* Tablet y móvil: la altura deja libre la barra inferior y crece cuando
     algún texto necesita más espacio. Esto evita cortes y grandes huecos. */
  @media (max-width:899px) {
    .dfh-hero {
      height: auto;
      min-height: max(520px, calc(100svh - 109px));
      max-height: none;
      padding: 44px 28px 56px;
      align-items: flex-end;
    }
    .dfh-container {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-end;
      gap: clamp(34px, 5.5svh, 55px);
    }
    .dfh-texts { flex: initial; width: 100%; }
    .dfh-title { font-size: clamp(2.3rem, 5.4vw, 3.3rem); }
    .dfh-bottom { align-items: flex-start; flex-direction: column; gap: 18px; }
    .dfh-description { max-width: 58ch; }
    .dfh-pagination { align-self: flex-end; padding: 0; }
  }
  @media (max-width:768px) {
    .dfh-hero {
      min-height: max(460px, calc(100svh - 109px - var(--bottom-nav-height, 64px) - env(safe-area-inset-bottom, 0px)));
      padding-bottom: clamp(24px, 4svh, 42px);
    }
  }
  @media (max-width:600px) {
    .dfh-hero { padding: clamp(28px, 5svh, 52px) 20px clamp(22px, 3.5svh, 36px); }
    .dfh-container { gap: clamp(34px, 5.5svh, 55px); }
    .dfh-title {
      max-width: 13.8ch;
      margin-bottom: 16px;
      font-size: clamp(30px, 8.4vw, 42px);
      line-height: 1.065;
      letter-spacing: -.046em;
    }
    .dfh-description { font-size: 13.5px; line-height: 1.55; max-width: 45ch; }
    .dfh-bottom { gap: 17px; }
    .dfh-cta { min-height: 48px; }
    .dfh-pagination { gap: 9px; }
  }
  /* Pantallas cortas: evitar grandes paddings sin cortar el texto. */
  @media (max-width:600px) and (max-height:710px) {
    .dfh-hero { padding-top: 22px; padding-bottom: 20px; }
    .dfh-container { gap: 30px; }
    .dfh-title { font-size: clamp(28px, 7.8vw, 35px); margin-bottom: 12px; }
    .dfh-description { font-size: 12.5px; line-height: 1.48; }
    .dfh-bottom { gap: 14px; }
  }
  @media(prefers-reduced-motion:reduce){.dfh-photo{transform:none!important;transition:none!important}.dfh-cta-circle{transition:none!important}.dfh-pane{animation:none!important}}
</style>
<script>
  const hero=document.querySelector<HTMLElement>('[data-dfh]');
  if(hero){
    const photos=Array.from(hero.querySelectorAll<HTMLElement>('[data-dfh-photo]'));
    const panes=Array.from(hero.querySelectorAll<HTMLElement>('[data-dfh-pane]'));
    const dots=Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-dfh-dot]'));
    const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
    let current=0;let timer:number|undefined;let interacting=false;
    const stop=()=>{clearInterval(timer);timer=undefined};
    const show=(index:number)=>{
      current=(index+photos.length)%photos.length;
      photos.forEach((el,i)=>el.classList.toggle('is-active',i===current));
      panes.forEach((el,i)=>{const active=i===current;el.classList.toggle('is-active',active);el.setAttribute('aria-hidden',String(!active));el.inert=!active});
      dots.forEach((el,i)=>{el.classList.toggle('is-active',i===current);el.setAttribute('aria-pressed',String(i===current))});
    };
    const start=()=>{stop();if(!reduced.matches&&!document.hidden&&!interacting&&photos.length>1)timer=window.setInterval(()=>show(current+1),7500)};
    dots.forEach((dot,i)=>dot.addEventListener('click',()=>{show(i);start()}));
    // Do not pause on pointer hover across the whole hero: a cursor resting on
    // the image should never block the automatic transition.
    hero.addEventListener('focusin',()=>{interacting=true;stop()});
    hero.addEventListener('focusout',e=>{if(!hero.contains(e.relatedTarget as Node)){interacting=false;start()}});
    document.addEventListener('visibilitychange',start);
    reduced.addEventListener('change',start);
    start();
  }
</script>
