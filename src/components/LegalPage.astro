---
import Layout from '../layouts/Layout.astro';
interface Props { title: string; summary: string; path: string; updated?: string; }
const { title, summary, path, updated = 'Noviembre de 2026' } = Astro.props;
---
<Layout title={`${title} | Depofibra`} description={summary} canonical={`https://depofibra.com${path}`}>
  <Fragment slot="head"><meta name="robots" content="noindex,follow" /></Fragment>
  <div class="legal-page">
    <div class="container">
      <nav class="legal-breadcrumb" aria-label="Migas de pan"><a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
      <header class="legal-header"><span class="legal-eyebrow">INFORMACIÓN LEGAL</span><h1>{title}</h1><p>{summary}</p><small>Versión de trabajo · {updated}</small></header>
      <div class="legal-layout">
        <article class="legal-content"><slot /></article>
        <aside class="legal-aside">
          <strong>Depofibra</strong>
          <p>Atención comercial desde Casariche (Sevilla). Visitas solo con cita previa.</p>
          <a href="tel:+34642129233">642 129 233</a>
          <a href="mailto:depofibra21@gmail.com">depofibra21@gmail.com</a>
          <nav aria-label="Otras páginas legales">
            <a href="/aviso-legal/">Aviso legal</a>
            <a href="/politica-de-privacidad/">Privacidad</a>
            <a href="/politica-de-cookies/">Cookies</a>
          </nav>
        </aside>
      </div>
    </div>
  </div>
</Layout>
<style>
  .legal-page{background:#fff;color:var(--color-dark);padding:20px 0 90px}
  .legal-breadcrumb{display:flex;align-items:center;gap:10px;margin:0 0 38px;font:600 12px/1.5 var(--font-body);color:var(--color-gray-500)}
  .legal-breadcrumb a{color:var(--color-primary)}
  .legal-header{max-width:850px;margin:0 0 52px}
  .legal-eyebrow{font:800 11px/1.4 var(--font-display);letter-spacing:.13em;color:var(--color-primary)}
  .legal-header h1{font:800 clamp(2.3rem,5.2vw,4rem)/1.06 var(--font-display);letter-spacing:-.055em;margin:10px 0 15px;color:var(--color-primary-dark)}
  .legal-header p{font:400 17px/1.75 var(--font-body);color:var(--color-gray-600);max-width:720px}
  .legal-header small{display:block;color:var(--color-gray-500);margin-top:20px;font-size:12px}
  .legal-layout{display:grid;grid-template-columns:minmax(0,1fr) 290px;align-items:start;gap:clamp(35px,7vw,105px)}
  .legal-content{max-width:850px;font:400 15px/1.85 var(--font-body);color:var(--color-gray-600)}
  .legal-content :global(h2){font:800 clamp(18px,2.2vw,23px)/1.28 var(--font-display);letter-spacing:-.035em;margin:34px 0 12px;color:var(--color-dark)}
  .legal-content :global(h2:first-child){margin-top:0}
  .legal-content :global(p){margin:0 0 16px}
  .legal-content :global(ul){list-style:disc;padding-left:20px;margin:0 0 20px}
  .legal-content :global(li){margin-bottom:7px}
  .legal-content :global(a){color:var(--color-primary);text-decoration:underline;text-underline-offset:3px}
  .legal-content :global(.legal-note){padding:17px 19px;background:#eaf2fb;border-left:3px solid var(--color-primary);border-radius:0 10px 10px 0;font-size:14px;line-height:1.7}
  .legal-aside{position:sticky;top:105px;background:#f6f9fc;border:1px solid #e0e9f2;border-radius:18px;padding:24px;display:flex;flex-direction:column;gap:11px;overflow-wrap:anywhere}
  .legal-aside strong{font:800 19px var(--font-display);color:var(--color-primary-dark)}
  .legal-aside p{font:400 13px/1.7 var(--font-body);color:var(--color-gray-600);margin-bottom:3px}
  .legal-aside>a{color:var(--color-primary);font:800 13px/1.5 var(--font-body)}
  .legal-aside nav{display:grid;gap:12px;border-top:1px solid #dbe6ef;margin-top:13px;padding-top:18px}
  .legal-aside nav a{font:700 13px/1.3 var(--font-body);color:var(--color-gray-700)}
  .legal-aside nav a:hover,.legal-aside>a:hover{color:var(--color-primary-dark)}
  @media(max-width:850px){.legal-layout{grid-template-columns:1fr}.legal-aside{position:static;max-width:none}.legal-page{padding-bottom:65px}.legal-header{margin-bottom:35px}}
  @media(max-width:600px){.legal-breadcrumb{margin-bottom:23px}.legal-header p{font-size:15px}}
</style>
