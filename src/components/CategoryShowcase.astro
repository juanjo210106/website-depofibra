---
/**
 * DEPOFIBRA — catálogo visual para la Home.
 * Cuatro familias, cuatro composiciones derivadas de fotografías aportadas. Sin productos extra.
 * La tarjeta principal se alterna sin intervención cada 6 s mientras la sección es visible.
 * En móvil se desplaza únicamente el carrusel horizontal, nunca la página completa.
 */
const categories = [
  {
    title: 'Depósitos',
    desc: 'Verticales, horizontales y para enterrar',
    link: '/depositos/',
    image: '/images/productos/categoria-depositos.jpg',
    alt: 'Depósito vertical de poliéster fotografiado en una instalación exterior',
    note: 'Depósitos de poliéster',
  },
  {
    title: 'Piscinas',
    desc: 'Piscinas prefabricadas de poliéster',
    link: '/piscinas/',
    image: '/images/productos/categoria-piscinas.jpg',
    alt: 'Piscina prefabricada instalada en una vivienda',
    note: 'Piscinas de poliéster',
  },
  {
    title: 'Fosas sépticas',
    desc: 'Estancas, filtro biológico y oxidación total',
    link: '/fosas-septicas/',
    image: '/images/productos/categoria-fosas.jpg',
    alt: 'Equipo de saneamiento con cuerpo nervado y bocas superiores',
    note: 'Soluciones de saneamiento',
  },
  {
    title: 'Cubas y cisternas',
    desc: 'Depósitos horizontales y cubas agrícolas',
    link: '/cubas-cisternas/',
    image: '/images/productos/categoria-cubas.jpg',
    alt: 'Depósito horizontal blanco con soportes metálicos azules',
    note: 'Cubas y cisternas',
  },
];
---
<section class="df-catalog" id="catalogo" aria-labelledby="catalog-heading" data-df-catalog>
  <div class="df-catalog__container">
    <header class="df-catalog__heading">
      <span class="df-catalog__eyebrow">NUESTROS PRODUCTOS</span>
      <h2 id="catalog-heading">Encuentra el producto <span>que necesitas</span></h2>
      <p>Depósitos de poliéster, piscinas, fosas sépticas y cubas. Elige una categoría para consultar sus modelos y solicitar presupuesto.</p>
    </header>
    <div class="df-catalog__stage">
      <div class="df-catalog__track" data-catalog-track role="list" aria-label="Familias de productos">
        {categories.map((category, i) => (
          <div class:list={['df-catalog__item', {'is-featured':i===0}]} role="listitem" data-category-item={i}>
            <a class="df-catalog__card" href={category.link} aria-label={`Ver ${category.title}`}>
              <img class="df-catalog__photo" src={category.image} alt={category.alt} loading="lazy" width="900" height="1220" decoding="async" />
              <span class="df-catalog__scrim" aria-hidden="true"></span>
              <span class="df-catalog__content">
                <span class="df-catalog__intro">{category.note}</span>
                <span class="df-catalog__title">{category.title}</span>
                <span class="df-catalog__description">{category.desc}</span>
                <span class="df-catalog__circle" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </span>
            </a>
          </div>
        ))}
      </div>
      <div class="df-catalog__controls">
        <button class="df-catalog__arrow" type="button" data-category-prev aria-label="Mostrar categoría anterior">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M19 12H5m7 7-7-7 7-7"/></svg>
        </button>
        <div class="df-catalog__dots" role="group" aria-label="Destacar categoría">
          {categories.map((category,i) => <button type="button" class:list={['df-catalog__dot', {'is-featured':i===0}]} data-category-dot={i} aria-label={`Destacar ${category.title}`} aria-pressed={i===0?'true':'false'} />)}
        </div>
        <button class="df-catalog__arrow" type="button" data-category-next aria-label="Mostrar categoría siguiente">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .df-catalog{background:#f7fafd;padding:82px 0 84px;overflow:hidden}
  .df-catalog__container{width:min(1380px,calc(100% - 72px));margin-inline:auto}
  .df-catalog__heading{text-align:center;max-width:760px;margin:0 auto 48px}
  .df-catalog__eyebrow{display:block;color:#01488e;font:800 11px/1.5 var(--font-display,'Plus Jakarta Sans',sans-serif);letter-spacing:.15em;margin-bottom:14px}
  .df-catalog__heading h2{margin:0 0 12px;color:#002d59;font:800 clamp(2.05rem,3.4vw,3.15rem)/1.13 var(--font-display,'Plus Jakarta Sans',sans-serif);letter-spacing:-.045em}
  .df-catalog__heading h2 span{color:#01488e}
  .df-catalog__heading p{margin:0;color:#475569;font:400 15px/1.7 var(--font-body,Inter,sans-serif)}
  .df-catalog__track{display:flex;align-items:stretch;gap:18px;min-height:480px}
  .df-catalog__item{min-width:0;flex:1 1 0;opacity:.88;filter:saturate(.86);transform:scale(.975);transition:flex-grow .72s cubic-bezier(.18,.85,.22,1),opacity .5s ease,transform .5s ease,filter .5s ease}
  .df-catalog__item.is-featured{flex-grow:1.58;opacity:1;filter:none;transform:translateY(-10px)}
  .df-catalog__item:focus-within,.df-catalog__item:hover{opacity:1;filter:none;transform:translateY(-5px)}
  .df-catalog__card{position:relative;display:block;width:100%;height:480px;border-radius:26px;overflow:hidden;isolation:isolate;background:#dce8f3;color:#fff;text-decoration:none;box-shadow:0 12px 28px rgba(0,38,75,.08);transition:box-shadow .25s ease}
  .df-catalog__card:hover{box-shadow:0 22px 38px rgba(0,38,75,.19)}
  .df-catalog__item.is-featured .df-catalog__card{box-shadow:0 24px 48px rgba(0,45,89,.22)}
  .df-catalog__item.is-featured .df-catalog__circle{background:#01488e;color:#fff;transform:translateX(2px)}
  .df-catalog__item.is-featured .df-catalog__title{font-size:clamp(25px,2.3vw,33px)}
  .df-catalog__item.is-featured .df-catalog__intro{color:#fff}
  .df-catalog__card:focus-visible{outline:4px solid #1986dc;outline-offset:4px}
  .df-catalog__photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;max-width:none;transition:transform .65s ease}
  .df-catalog__item:first-child .df-catalog__photo{object-position:center}
  .df-catalog__card:hover .df-catalog__photo,.df-catalog__card:focus-visible .df-catalog__photo{transform:scale(1.065)}
  .df-catalog__scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,34,67,.01) 0%,rgba(0,34,67,.04) 36%,rgba(0,35,68,.56) 67%,rgba(0,28,56,.97) 100%)}
  .df-catalog__content{position:absolute;z-index:1;inset:auto 0 0;display:grid;gap:8px;padding:25px 24px 26px;min-width:0}
  .df-catalog__intro{font:700 10px/1.4 var(--font-body,Inter,sans-serif);letter-spacing:.07em;text-transform:uppercase;color:#cfe7ff}
  .df-catalog__title{display:block;margin:0;padding-right:33px;font:800 clamp(21px,2vw,29px)/1.17 var(--font-display,'Plus Jakarta Sans',sans-serif);letter-spacing:-.035em;color:#fff;text-wrap:balance}
  .df-catalog__description{display:block;max-width:220px;padding-right:15px;color:rgba(255,255,255,.91);font:400 13px/1.5 var(--font-body,Inter,sans-serif)}
  .df-catalog__circle{position:absolute;right:20px;bottom:23px;display:grid;place-items:center;width:43px;height:43px;border-radius:50%;background:#fff;color:#01488e;transition:transform .22s ease,background .22s ease}
  .df-catalog__card:hover .df-catalog__circle,.df-catalog__card:focus-visible .df-catalog__circle{transform:translateX(4px);background:#eaf2fb}
  .df-catalog__controls{display:flex;justify-content:center;align-items:center;gap:22px;margin-top:27px}
  .df-catalog__arrow{display:grid;place-items:center;width:45px;height:45px;border:1px solid #dce5ef;border-radius:50%;color:#01488e;background:#fff;cursor:pointer;transition:background .2s ease,color .2s ease}
  .df-catalog__arrow:hover{background:#01488e;color:#fff}
  .df-catalog__dots{display:flex;align-items:center;gap:12px}
  .df-catalog__dot{width:13px;height:13px;border:0;border-radius:50%;background:#cbd7e5;cursor:pointer;transition:background .2s ease,transform .2s ease}
  .df-catalog__dot.is-featured{background:#01488e;transform:scale(1.12)}
  .df-catalog__dot:focus-visible,.df-catalog__arrow:focus-visible{outline:3px solid #0b76cf;outline-offset:4px}
  @media(max-width:1050px){.df-catalog__container{width:calc(100% - 40px)}.df-catalog__track{gap:12px}.df-catalog__card{height:430px}.df-catalog__content{padding:18px 15px 20px}.df-catalog__title{font-size:21px}.df-catalog__description{font-size:12px}.df-catalog__circle{width:36px;height:36px;right:12px;bottom:16px}}
  /* Portátiles con ventana baja: mostrar el catálogo sin grandes zonas vacías. */
  @media (min-width:901px) and (max-height:820px) {
    .df-catalog{padding:clamp(30px,4svh,50px) 0 clamp(28px,4svh,48px)}
    .df-catalog__heading{margin-bottom:24px}
    .df-catalog__heading h2{font-size:clamp(1.95rem,3vw,2.7rem)}
    .df-catalog__track{min-height:0}
    .df-catalog__card{height:clamp(300px,44svh,400px)}
    .df-catalog__controls{margin-top:16px}
  }
  @media(max-width:900px){
    .df-catalog{padding:clamp(24px,3.6svh,42px) 0 28px}
    .df-catalog__container{width:100%}
    .df-catalog__heading{margin:0 auto 18px;padding:0 22px}
    .df-catalog__eyebrow{margin-bottom:8px}
    .df-catalog__heading h2{font-size:clamp(1.82rem,6.3vw,2.4rem);line-height:1.08;margin-bottom:8px}
    .df-catalog__heading p{font-size:13px;line-height:1.5}
    /* Dos pistas laterales: última familia a la izquierda y siguiente a la derecha. */
    .df-catalog__track{
      min-height:0;
      overflow-x:auto;
      gap:14px;
      padding:4px calc((100% - min(72vw,300px))/2) 10px;
      scroll-padding-inline:calc((100% - min(72vw,300px))/2);
      scroll-snap-type:x mandatory;
      overscroll-behavior-x:contain;
      scrollbar-width:none;
      -webkit-overflow-scrolling:touch;
    }
    .df-catalog__track::-webkit-scrollbar{display:none}
    .df-catalog__item,.df-catalog__item.is-featured{
      flex:0 0 min(72vw,300px);
      transform:none;
      opacity:1;
      filter:none;
      scroll-snap-align:center;
    }
    .df-catalog__card{height:clamp(280px,43svh,370px);border-radius:22px;box-shadow:0 8px 20px rgba(0,38,75,.12)}
    .df-catalog__content{padding:18px 18px 20px}
    .df-catalog__title{font-size:clamp(22px,5.2vw,26px)}
    .df-catalog__description{font-size:12.5px}
    .df-catalog__circle{width:40px;height:40px;right:16px;bottom:18px}
    .df-catalog__controls{margin-top:8px;gap:18px}
    .df-catalog__arrow{width:39px;height:39px}
    .df-catalog__dots{gap:10px}
    .df-catalog__dot{width:11px;height:11px}
  }
  @media (max-width:600px) and (max-height:740px) {
    .df-catalog{padding:18px 0 16px}
    .df-catalog__heading{margin-bottom:12px}
    .df-catalog__heading h2{font-size:clamp(1.63rem,7vw,2rem)}
    .df-catalog__heading p{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:12px}
    .df-catalog__card{height:clamp(235px,39svh,300px)}
    .df-catalog__controls{margin-top:4px}
    .df-catalog__arrow{width:35px;height:35px}
  }
  @media(prefers-reduced-motion:reduce){.df-catalog__item,.df-catalog__photo,.df-catalog__dot,.df-catalog__circle{transition:none!important}}
</style>
<script>
  const catalog = document.querySelector<HTMLElement>('[data-df-catalog]');
  if (catalog) {
    const track = catalog.querySelector<HTMLElement>('[data-catalog-track]');
    const items = Array.from(catalog.querySelectorAll<HTMLElement>('[data-category-item]'));
    const dots = Array.from(catalog.querySelectorAll<HTMLButtonElement>('[data-category-dot]'));
    const prev = catalog.querySelector<HTMLButtonElement>('[data-category-prev]');
    const next = catalog.querySelector<HTMLButtonElement>('[data-category-next]');
    const narrow = window.matchMedia('(max-width:900px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let timer: number | undefined;
    let scrollTimeout: number | undefined;
    let wrapTimeout: number | undefined;
    let inView = false;
    let keyboardInteraction = false;
    let touchUntil = 0;
    let lastClone: HTMLElement | null = null;
    let firstClone: HTMLElement | null = null;
    let repositioning = false;
    let wrapInProgress = false;

    const stop = () => { window.clearInterval(timer); timer = undefined; };
    const updateState = () => {
      items.forEach((item, i) => item.classList.toggle('is-featured', i === active));
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-featured', i === active);
        dot.setAttribute('aria-pressed', String(i === active));
      });
    };
    const targetLeft = (el: HTMLElement) => {
      if (!track) return 0;
      const rect = el.getBoundingClientRect();
      const frame = track.getBoundingClientRect();
      return track.scrollLeft + rect.left - frame.left + (rect.width - frame.width) / 2;
    };
    const center = (el: HTMLElement, smooth: boolean) => {
      if (!track) return;
      track.scrollTo({ left: targetLeft(el), behavior: smooth && !reduced.matches ? 'smooth' : 'auto' });
    };
    const jumpToOriginal = () => {
      if (!track || !narrow.matches) return;
      repositioning = true;
      // Recolocar tras mostrar un clon sin desplazar verticalmente la página.
      track.style.scrollSnapType = 'none';
      center(items[active], false);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        track.style.scrollSnapType = '';
        repositioning = false;
        wrapInProgress = false;
      }));
    };
    const makeClone = (item: HTMLElement) => {
      const clone = item.cloneNode(true) as HTMLElement;
      clone.removeAttribute('data-category-item');
      clone.classList.remove('is-featured');
      clone.setAttribute('aria-hidden', 'true');
      clone.inert = true;
      clone.setAttribute('data-category-clone', '');
      return clone;
    };
    const syncMobile = () => {
      if (!track || !items.length) return;
      window.clearTimeout(wrapTimeout);
      wrapInProgress = false;
      if (narrow.matches && !lastClone) {
        lastClone = makeClone(items[items.length - 1]);
        firstClone = makeClone(items[0]);
        track.prepend(lastClone);
        track.append(firstClone);
        // Inicio con dos fragmentos laterales visibles, incluido el último producto.
        requestAnimationFrame(() => jumpToOriginal());
      } else if (!narrow.matches && lastClone) {
        lastClone.remove();
        firstClone?.remove();
        lastClone = null;
        firstClone = null;
        track.scrollLeft = 0;
      }
    };
    const move = (index: number, scroll = true) => {
      if (!items.length) return;
      const prior = active;
      active = (index + items.length) % items.length;
      updateState();
      if (!narrow.matches || !scroll) return;
      let el = items[active];
      let wrap = false;
      if (lastClone && prior === 0 && active === items.length - 1) {
        el = lastClone; wrap = true;
      } else if (firstClone && prior === items.length - 1 && active === 0) {
        el = firstClone; wrap = true;
      }
      center(el, true);
      if (wrap) {
        wrapInProgress = true;
        window.clearTimeout(wrapTimeout);
        wrapTimeout = window.setTimeout(jumpToOriginal, reduced.matches ? 40 : 590);
      }
    };
    const start = () => {
      stop();
      if (inView && !reduced.matches && !document.hidden && !keyboardInteraction && items.length > 1) {
        timer = window.setInterval(() => {
          if (Date.now() >= touchUntil && !wrapInProgress) move(active + 1);
        }, 6500);
      }
    };
    const manual = (index: number) => {
      touchUntil = Date.now() + 8500;
      move(index);
      start();
    };
    dots.forEach((dot, i) => dot.addEventListener('click', () => manual(i)));
    prev?.addEventListener('click', () => manual(active - 1));
    next?.addEventListener('click', () => manual(active + 1));
    catalog.addEventListener('focusin', () => { keyboardInteraction = true; stop(); });
    catalog.addEventListener('focusout', event => {
      if (!catalog.contains(event.relatedTarget as Node)) { keyboardInteraction = false; start(); }
    });
    track?.addEventListener('pointerdown', () => { touchUntil = Date.now() + 10000; }, { passive: true });
    track?.addEventListener('scroll', () => {
      if (!narrow.matches || !track || repositioning || wrapInProgress) return;
      window.clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(() => {
        if (!track || repositioning || wrapInProgress) return;
        const frame = track.getBoundingClientRect();
        const middle = frame.left + frame.width / 2;
        const all = [lastClone, ...items, firstClone].filter(Boolean) as HTMLElement[];
        let closest = all[0];
        let distance = Infinity;
        for (const item of all) {
          const rect = item.getBoundingClientRect();
          const d = Math.abs(rect.left + rect.width / 2 - middle);
          if (d < distance) { distance = d; closest = item; }
        }
        if (closest === lastClone) {
          active = items.length - 1; updateState(); jumpToOriginal();
        } else if (closest === firstClone) {
          active = 0; updateState(); jumpToOriginal();
        } else {
          const found = items.indexOf(closest);
          if (found >= 0) { active = found; updateState(); }
        }
      }, 200);
    }, { passive: true });
    narrow.addEventListener('change', () => { syncMobile(); start(); });
    reduced.addEventListener('change', start);
    document.addEventListener('visibilitychange', start);
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        inView = entries.some(entry => entry.isIntersecting);
        start();
      }, { threshold: 0.2 });
      observer.observe(catalog);
    } else { inView = true; }
    updateState();
    syncMobile();
    start();
  }
</script>
