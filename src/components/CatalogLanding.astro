---
import Layout from '../layouts/Layout.astro';
interface Item {id:string; name:string; subtitle:string; image:string; tags:string[]; badge?:string; detail?:string; href?:string; photo?:boolean }
interface Props {nav:'depositos'|'piscinas'|'fosas'|'cubas'; title:string; description:string; intro:string; eyebrow:string; filters:{id:string;label:string}[];items:Item[]; note:string; helperTitle:string;helperText:string;feature?:{title:string;description:string;href?:string;image:string;eyebrow:string}; faqs?:{question:string;answer:string}[];}
const {nav,title,description,intro,eyebrow,filters,items,note,helperTitle,helperText,feature,faqs=[]}=Astro.props;
const base={'depositos':'depositos','piscinas':'piscinas','fosas':'fosas-septicas','cubas':'cubas-cisternas'}[nav];
---
<Layout title={`${title} | Depofibra`} description={description} canonical={`https://depofibra.com/${base}/`} activeNav={nav}>
<div class="cl-page">
 <div class="cl-intro container">
  <nav class="cl-breadcrumb" aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><span>{title}</span></nav>
  <div class="cl-intro__head"><div><div class="cl-overline">{eyebrow}</div><h1>{title}<span class="cl-period">.</span></h1><p>{intro}</p></div><div class="cl-intro__side"><span>DEPOFIBRA / CATÁLOGO</span><p>Selecciona el formato que necesitas y accede a su información o solicita presupuesto.</p></div></div>
 </div>
 <section class="cl-catalog container" aria-labelledby="cl-products">
  <div class="cl-catalog__title"><h2 id="cl-products">Explora los modelos</h2><span class="cl-result" aria-live="polite">{items.length} opciones</span></div>
  <div class="cl-shop">
   <div class="cl-grid" id="cl-grid">
      {items.map((item,index)=><article class:list={['cl-product',{'cl-product--featured':index===0}]} data-tags={item.tags.join(' ')}>
        <a href={item.href ?? `#${item.id}`} class="cl-product__image" aria-label={`Ver información sobre ${item.name}`}><img src={item.image} loading={index<3?'eager':'lazy'} alt={`${item.name} — imagen orientativa, confirmar referencia comercial`} /><span class="cl-product__round">↗</span></a>
        <div class="cl-product__content"><span class="cl-product__meta">{item.badge??item.subtitle}</span><h3><a href={item.href??`#${item.id}`}>{item.name}</a></h3><p>{item.subtitle}</p><button class="cl-product__quote open-quote-trigger" type="button" data-product={item.name}>Consultar presupuesto <span aria-hidden="true">↗</span></button></div>
      </article>)}
   </div>
  </div>
  <p class="cl-note">{note}</p>
 </section>
 {feature&&<section class="cl-feature"><div class="container cl-feature__inner"><div><span class="cl-overline">{feature.eyebrow}</span><h2>{feature.title}</h2><p>{feature.description}</p><a href={feature.href??'#cl-grid'}>Ver opciones <span aria-hidden="true">↗</span></a></div><img src={feature.image} loading="lazy" alt="Imagen ilustrativa de la gama, verificar modelo y características"/></div></section>}
 <section class="cl-support container"><div><span class="cl-overline">ELEGIR CON CRITERIO</span><h2>{helperTitle}</h2></div><div><p>{helperText}</p><button type="button" class="open-quote-trigger">Solicitar orientación <span>↗</span></button></div></section>
 <section class="cl-content container" aria-label="Información por tipo de producto"><div class="cl-content__intro"><span class="cl-overline">INFORMACIÓN PARA DECIDIR</span><h2>Conoce las diferencias entre formatos.</h2></div><div class="cl-content__items">{items.map((item,index)=><article class="cl-content__item" id={item.id}><span>{String(index+1).padStart(2,'0')}</span><div><h3>{item.name}</h3><p>{item.detail??item.subtitle}</p></div><button class="open-quote-trigger" type="button" aria-label={`Pedir presupuesto de ${item.name}`}>Consultar ↗</button></article>)}</div></section>
 {faqs.length>0&&<section class="cl-faq container"><span class="cl-overline">PREGUNTAS FRECUENTES</span><h2>Dudas habituales antes de comprar</h2><div>{faqs.map(f=><details><summary>{f.question}<span>+</span></summary><p>{f.answer}</p></details>)}</div></section>}
 </div>
</Layout>
<script>
 document.querySelectorAll<HTMLElement>('.cl-page').forEach(page=>{

  page.querySelectorAll<HTMLButtonElement>('.cl-product__quote').forEach(b=>b.addEventListener('click',()=>{const select=document.querySelector<HTMLSelectElement>('#quote-product,select[name="producto"],select[name="product"]'); if(select){const match=Array.from(select.options).find(o=>o.textContent?.toLowerCase().includes((b.dataset.product||'').toLowerCase()));if(match) select.value=match.value;}}));
 });
</script>
<style>
 .cl-page{background:#f6f7f5;color:#152334;padding-bottom:0}.cl-intro{padding:30px 0 28px}.cl-breadcrumb{display:flex;gap:10px;color:#87939c;font:600 12px var(--font-body);margin-bottom:28px}.cl-breadcrumb a{color:#01488e;text-decoration:none}.cl-intro__head{display:flex;justify-content:space-between;align-items:flex-end;gap:38px}.cl-overline{color:#01488e;font:800 10px/1.5 var(--font-display);letter-spacing:.15em}.cl-intro h1{color:#13212e;font:800 clamp(45px,6vw,91px)/.99 var(--font-display);letter-spacing:-.075em;margin:10px 0 18px}.cl-period{color:#01488e}.cl-intro p{max-width:670px;color:#697886;line-height:1.7;font-size:15px}.cl-intro__side{border-left:1px solid #cbd5db;padding-left:22px;max-width:255px;flex-shrink:0}.cl-intro__side span{font:800 10px var(--font-display);color:#01488e;letter-spacing:.1em}.cl-intro__side p{font-size:12px;margin-top:11px}
 .cl-catalog{padding-top:16px;padding-bottom:50px}.cl-catalog__title{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #cfd9df;padding-top:22px;padding-bottom:20px}.cl-catalog__title h2{font:800 clamp(20px,2.6vw,30px) var(--font-display);letter-spacing:-.04em;margin:0;color:#152334}.cl-result{font-size:12px;color:#6a7884}
 .cl-shop{display:block}
 .cl-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}.cl-product{background:#fff;border:1px solid #e2e5e4;min-width:0}.cl-product[hidden]{display:none!important}.cl-product__image{display:block;position:relative;background:#e9edec;aspect-ratio:1.22;overflow:hidden}.cl-product__image img{display:block;width:100%;height:100%;object-fit:contain;padding:12px;mix-blend-mode:multiply;transition:transform .45s}.cl-product__image:hover img{transform:scale(1.05)}.cl-product__round{position:absolute;bottom:12px;right:12px;border-radius:50%;background:#01488e;color:#fff;width:37px;height:37px;display:grid;place-items:center;font-size:21px;transition:transform .2s}.cl-product__image:hover .cl-product__round{transform:rotate(45deg)}.cl-product__content{padding:17px}.cl-product__meta{font:800 10px var(--font-display);color:#01488e;letter-spacing:.05em;text-transform:uppercase}.cl-product h3{font:800 clamp(17px,1.7vw,22px)/1.14 var(--font-display);letter-spacing:-.04em;margin:10px 0 8px}.cl-product h3 a{color:#1c2b39;text-decoration:none}.cl-product h3 a:hover{color:#01488e}.cl-product p{color:#71808a;font-size:12px;line-height:1.65;min-height:38px}.cl-product__quote{margin-top:15px;padding:13px 0 0;border:0;border-top:1px solid #e7ebed;background:none;width:100%;display:flex;justify-content:space-between;color:#01488e;font:800 11px var(--font-display);cursor:pointer}.cl-product__quote span{font-size:17px}.cl-empty{grid-column:1/-1;padding:20px;color:#667683}.cl-note{font-size:11px;color:#6d7a84;margin-top:17px}
 .cl-feature{background:#eaf2fb;margin-top:15px;padding:55px 0}.cl-feature__inner{display:grid;grid-template-columns:1fr .95fr;gap:60px;align-items:center}.cl-feature h2{font:800 clamp(26px,4vw,49px)/1.07 var(--font-display);letter-spacing:-.055em;color:#002d59;margin:12px 0}.cl-feature p{font-size:15px;color:#607384;line-height:1.8;max-width:560px}.cl-feature a{display:inline-flex;margin-top:20px;background:#01488e;padding:14px 18px;color:#fff;text-decoration:none;font:800 12px var(--font-display);gap:25px}.cl-feature img{width:100%;aspect-ratio:1.6;object-fit:contain;mix-blend-mode:multiply}.cl-support{display:grid;grid-template-columns:1fr 1fr;gap:50px;padding-block:70px}.cl-support h2{font:800 clamp(25px,3vw,42px)/1.1 var(--font-display);letter-spacing:-.045em;margin:10px 0;color:#002d59}.cl-support p{font-size:15px;line-height:1.8;color:#637482}.cl-support button{border:0;background:#01488e;color:white;font:800 12px var(--font-display);padding:15px 20px;margin-top:22px;cursor:pointer}
 @media(max-width:1050px){.cl-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:740px){.cl-intro{padding-top:15px}.cl-intro__head{display:block}.cl-intro__side{display:none}.cl-intro h1{font-size:48px}.cl-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.cl-product__image{aspect-ratio:1}.cl-product__content{padding:12px}.cl-product h3{font-size:15px}.cl-product__meta{font-size:9px}.cl-product p{font-size:11px}.cl-product__quote{font-size:10px}.cl-feature{padding:30px 0}.cl-feature__inner,.cl-support{grid-template-columns:1fr;gap:18px}.cl-feature img{max-width:440px}.cl-support{padding-block:45px}}

 .cl-content{padding:15px 0 65px;display:grid;grid-template-columns:.57fr 1fr;gap:40px}.cl-content h2,.cl-faq h2{font:800 clamp(23px,2.8vw,38px)/1.13 var(--font-display);letter-spacing:-.05em;color:#002d59;margin:10px 0}.cl-content__item{scroll-margin-top:110px;border-top:1px solid #dce5ea;display:grid;grid-template-columns:32px 1fr auto;gap:18px;align-items:start;padding:22px 0}.cl-content__item>span{font:800 10px var(--font-display);color:#01488e;padding-top:6px}.cl-content__item h3{font:800 17px var(--font-display);letter-spacing:-.03em;color:#1d303e;margin:0 0 8px}.cl-content__item p{font:400 13px/1.75 var(--font-body);color:#637580;margin:0;max-width:590px}.cl-content__item button{border:0;background:none;color:#01488e;font:800 11px var(--font-display);cursor:pointer}.cl-faq{padding-bottom:75px}.cl-faq>div{margin-top:20px;border-top:1px solid #dce5ea}.cl-faq details{border-bottom:1px solid #dce5ea}.cl-faq summary{list-style:none;display:flex;justify-content:space-between;gap:16px;cursor:pointer;padding:20px 0;color:#233544;font:800 15px var(--font-display)}.cl-faq summary::-webkit-details-marker{display:none}.cl-faq summary span{font-size:20px;color:#01488e}.cl-faq details[open] summary span{transform:rotate(45deg)}.cl-faq details p{margin:0;padding:0 0 20px;color:#627482;font:400 14px/1.8 var(--font-body);max-width:860px}
 @media(max-width:740px){.cl-content{grid-template-columns:1fr;gap:15px;padding-bottom:45px}.cl-content__item{grid-template-columns:25px 1fr;gap:12px}.cl-content__item button{grid-column:2;justify-self:start}.cl-faq{padding-bottom:50px}}
</style>
