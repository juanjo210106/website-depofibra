---
/**
 * Barra de navegación inferior fija para móvil.
 * Cuatro destinos: Inicio | Productos | Pedir precio | Contacto
 * Se oculta en escritorio (nav horizontal en header).
 */
interface Props {
  activeNav?: string;
}

const { activeNav = 'inicio' } = Astro.props;
---

<nav class="mobile-nav" id="mobileNav" aria-label="Navegación rápida">
  <!-- Inicio -->
  <a
    href="/"
    class:list={['mobile-nav__item', { 'is-active': activeNav === 'inicio' }]}
    {...(activeNav === 'inicio' ? { 'aria-current': 'page' } : {})}
  >
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
    <span>Inicio</span>
  </a>

  <!-- Productos -->
  <button
    class:list={['mobile-nav__item', {
      'is-active': ['depositos', 'piscinas', 'fosas', 'cubas'].includes(activeNav || '')
    }]}
    type="button"
    id="mobileProductsBtn"
    aria-expanded="false"
    aria-controls="mobileProductsPanel"
  >
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="7" height="7"></rect>
      <rect x="14" y="3" width="7" height="7"></rect>
      <rect x="14" y="14" width="7" height="7"></rect>
      <rect x="3" y="14" width="7" height="7"></rect>
    </svg>
    <span>Productos</span>
  </button>

  <!-- Pedir precio (destacado) -->
  <button
    class="mobile-nav__item mobile-nav__item--primary open-quote-trigger"
    type="button"
  >
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
      <polyline points="10 9 9 9 8 9"></polyline>
    </svg>
    <span>Pedir precio</span>
  </button>

  <!-- Contacto -->
  <button
    class="mobile-nav__item"
    type="button"
    id="mobileContactBtn"
    aria-expanded="false"
    aria-controls="mobileContactPanel"
  >
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    <span>Contacto</span>
  </button>
</nav>

<!-- Panel de productos -->
<div class="mobile-panel" id="mobileProductsPanel" role="dialog" aria-label="Categorías de producto" aria-modal="false">
  <div class="mobile-panel__content">
    <div class="mobile-panel__header">
      <h2 class="mobile-panel__title">Nuestros productos</h2>
      <button class="mobile-panel__close" type="button" aria-label="Cerrar panel">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <ul class="mobile-panel__list">
      <li>
        <a href="/depositos/" class="mobile-panel__link">
          <span class="mobile-panel__link-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="6" y="4" width="12" height="16" rx="2"></rect><line x1="6" y1="10" x2="18" y2="10"></line><line x1="6" y1="14" x2="18" y2="14"></line></svg>
          </span>
          <div>
            <strong>Depósitos</strong>
            <small>Verticales, horizontales y enterrables</small>
          </div>
          <svg class="mobile-panel__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
        </a>
      </li>
      <li>
        <a href="/piscinas/" class="mobile-panel__link">
          <span class="mobile-panel__link-icon mobile-panel__link-icon--pool">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="8" width="18" height="10" rx="2"></rect><path d="M3 13c2-2 4 2 6 0s4 2 6 0s4 2 6 0"></path></svg>
          </span>
          <div>
            <strong>Piscinas</strong>
            <small>Prefabricadas de poliéster</small>
          </div>
          <svg class="mobile-panel__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
        </a>
      </li>
      <li>
        <a href="/fosas-septicas/" class="mobile-panel__link">
          <span class="mobile-panel__link-icon mobile-panel__link-icon--fosa">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="14" rx="9" ry="5"></ellipse><path d="M8 9V5m8 4V5"></path><circle cx="8" cy="4" r="1.5"></circle><circle cx="16" cy="4" r="1.5"></circle></svg>
          </span>
          <div>
            <strong>Fosas sépticas</strong>
            <small>Estancas, filtro biológico y oxidación total</small>
          </div>
          <svg class="mobile-panel__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
        </a>
      </li>
      <li>
        <a href="/cubas-cisternas/" class="mobile-panel__link">
          <span class="mobile-panel__link-icon mobile-panel__link-icon--cuba">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="12" rx="9" ry="4"></ellipse><path d="M12 8V4"></path><circle cx="12" cy="3" r="1.5"></circle><circle cx="7" cy="19" r="2"></circle><circle cx="17" cy="19" r="2"></circle></svg>
          </span>
          <div>
            <strong>Cubas y cisternas</strong>
            <small>Cubas agrícolas y depósitos cisterna</small>
          </div>
          <svg class="mobile-panel__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
        </a>
      </li>
    </ul>
  </div>
</div>

<!-- Panel de contacto -->
<div class="mobile-panel" id="mobileContactPanel" role="dialog" aria-label="Contacto" aria-modal="false">
  <div class="mobile-panel__content">
    <div class="mobile-panel__header">
      <h2 class="mobile-panel__title">Contacta con nosotros</h2>
      <button class="mobile-panel__close" type="button" aria-label="Cerrar panel">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <div class="mobile-panel__contact-info">
      <p class="mobile-panel__contact-note">
        Atención comercial desde Casariche (Sevilla). Visitas exclusivamente con cita previa.
      </p>
      <ul class="mobile-panel__contact-list">
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Casariche, Sevilla, España</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          <a href="mailto:depofibra21@gmail.com">depofibra21@gmail.com</a>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.11 4.18 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.72c.12.9.34 1.77.65 2.61a2 2 0 0 1-.45 2.11L8.03 9.91a16 16 0 0 0 6.06 6.06l1.47-1.27a2 2 0 0 1 2.11-.45c.84.31 1.71.53 2.61.65A2 2 0 0 1 22 16.92z"/></svg>
          <a href="tel:+34642129233">642 129 233</a>
        </li>
      </ul>
      <button class="btn btn--primary btn--full open-quote-trigger" type="button">
        Solicitar presupuesto
        <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
</div>

<style>
  /* ═══════════════════════════════════════
     BARRA INFERIOR MÓVIL
     ═══════════════════════════════════════ */
  .mobile-nav {
    display: flex;
    align-items: stretch;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    height: auto;
    min-height: calc(var(--bottom-nav-height) + env(safe-area-inset-bottom, 0px));
    padding-bottom: max(env(safe-area-inset-bottom, 0px), 6px);
    box-sizing: border-box;
    background: var(--color-white);
    border-top: 1px solid var(--color-gray-200);
    box-shadow: 0 -2px 12px rgba(0, 18, 38, 0.08), 0 32px 0 var(--color-white);
  }



  .mobile-nav::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-1 * env(safe-area-inset-bottom, 0px));
    height: env(safe-area-inset-bottom, 0px);
    background: var(--color-white);
    pointer-events: none;
  }

  .mobile-nav__item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 6px 4px;
    border: none;
    background: none;
    color: var(--color-gray-500);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-nav__item svg {
    flex-shrink: 0;
  }

  .mobile-nav__item:hover,
  .mobile-nav__item.is-active {
    color: var(--color-primary);
  }

  .mobile-nav__item.is-active {
    font-weight: 800;
  }

  /* Pedir precio al mismo nivel que las otras tres opciones: sin botón circular sobresaliente. */
  .mobile-nav__item--primary {
    position: relative;
    color: var(--color-primary);
    font-weight: 800;
  }
  .mobile-nav__item--primary::before { content: none; }
  .mobile-nav__item--primary span { color: inherit; font-weight: 800; }
  .mobile-nav__item--primary svg { position: static; }

  /* Ocultar en escritorio */
  @media (min-width: 769px) {
    .mobile-nav {
      display: none;
    }
  }

  /* ═══════════════════════════════════════
     PANELES DESLIZANTES
     ═══════════════════════════════════════ */
  .mobile-panel {
    position: fixed;
    inset: 0;
    z-index: 95;
    display: flex;
    align-items: flex-end;
    background: rgba(0, 18, 38, 0.5);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .mobile-panel.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-panel__content {
    width: 100%;
    max-height: 80vh;
    overflow-y: auto;
    padding: 24px 20px calc(var(--bottom-nav-height) + 16px + env(safe-area-inset-bottom, 0px));
    background: var(--color-white);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    transform: translateY(100%);
    transition: transform 0.3s var(--ease-out);
  }

  .mobile-panel.is-open .mobile-panel__content {
    transform: translateY(0);
  }

  .mobile-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .mobile-panel__title {
    font: 800 20px/1.2 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-dark);
  }

  .mobile-panel__close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: var(--color-gray-100);
    color: var(--color-gray-600);
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .mobile-panel__close:hover {
    background: var(--color-gray-200);
  }

  /* Lista de productos */
  .mobile-panel__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-panel__link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 12px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-dark);
    transition: background var(--transition-fast);
  }

  .mobile-panel__link:hover,
  .mobile-panel__link:focus-visible {
    background: var(--color-gray-50);
  }

  .mobile-panel__link-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .mobile-panel__link-icon svg {
    width: 22px;
    height: 22px;
  }

  .mobile-panel__link div {
    flex: 1;
    min-width: 0;
  }

  .mobile-panel__link strong {
    display: block;
    font: 700 15px/1.3 var(--font-display);
    letter-spacing: -0.01em;
  }

  .mobile-panel__link small {
    display: block;
    margin-top: 2px;
    color: var(--color-gray-500);
    font-size: 12px;
    line-height: 1.4;
  }

  .mobile-panel__arrow {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--color-gray-400);
  }

  /* Panel de contacto */
  .mobile-panel__contact-note {
    margin-bottom: 20px;
    padding: 14px;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    color: var(--color-gray-700);
    font-size: 13px;
    line-height: 1.6;
  }

  .mobile-panel__contact-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
  }

  .mobile-panel__contact-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-gray-700);
    font-size: 14px;
    font-weight: 500;
  }

  .mobile-panel__contact-list svg {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  /* Ocultar paneles en escritorio */
  @media (min-width: 769px) {
    .mobile-panel {
      display: none;
    }
  }
</style>

<script>
  // Panel de productos
  const productsBtn = document.getElementById('mobileProductsBtn');
  const productsPanel = document.getElementById('mobileProductsPanel');

  // Panel de contacto
  const contactBtn = document.getElementById('mobileContactBtn');
  const contactPanel = document.getElementById('mobileContactPanel');

  function openPanel(panel: HTMLElement, btn: HTMLElement) {
    panel.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closePanel(panel: HTMLElement, btn: HTMLElement) {
    panel.classList.remove('is-open');
    btn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  function closeAllPanels() {
    if (productsPanel && productsBtn) closePanel(productsPanel, productsBtn);
    if (contactPanel && contactBtn) closePanel(contactPanel, contactBtn);
  }

  if (productsBtn && productsPanel) {
    productsBtn.addEventListener('click', () => {
      const isOpen = productsPanel.classList.contains('is-open');
      closeAllPanels();
      if (!isOpen) openPanel(productsPanel, productsBtn);
    });
  }

  if (contactBtn && contactPanel) {
    contactBtn.addEventListener('click', () => {
      const isOpen = contactPanel.classList.contains('is-open');
      closeAllPanels();
      if (!isOpen) openPanel(contactPanel, contactBtn);
    });
  }

  // Cerrar al clicar overlay
  document.querySelectorAll('.mobile-panel').forEach((panel) => {
    panel.addEventListener('click', (e) => {
      if (e.target === panel) closeAllPanels();
    });
  });

  // Botones de cerrar
  document.querySelectorAll('.mobile-panel__close').forEach((btn) => {
    btn.addEventListener('click', closeAllPanels);
  });

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllPanels();
  });
</script>
