---
import WhatsAppIcon from './WhatsAppIcon.astro';
/**
 * Ficha compartida para las cinco referencias fotográficas de piscinas.
 * Misma identidad que las fichas de depósitos; sin precios, stock o medidas técnicas inventadas.
 */
import Layout from '../layouts/Layout.astro';
import { poolModels, type PoolModel } from '../data/poolModels';

interface Props { model: PoolModel }
const { model } = Astro.props;
const related = poolModels.filter(item => item.slug !== model.slug).slice(0, 4);
const canonical = `https://depofibra.com/piscinas/${model.slug}/`;
const whatsappNumber = String(import.meta.env.PUBLIC_WHATSAPP_NUMBER || '34642129233').replace(/\D/g, '');
const message = `Hola, quisiera solicitar presupuesto de una ${model.shortName.toLowerCase()}. ¿Podéis confirmar las medidas, los modelos que tenéis y el transporte hasta mi localidad?`;
const whatsappHref = whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}` : '/contacto/';
const contactHref = `/contacto/?producto=${encodeURIComponent('Piscina')}&capacidad=${encodeURIComponent(model.measure + ' (medida orientativa)')}`;
---
<Layout
  title={model.titleSeo}
  description={model.metaDescription}
  canonical={canonical}
  ogImage={model.gallery[0].src}
  ogImageAlt={model.gallery[0].alt}
  activeNav="piscinas"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://depofibra.com/' },
        { '@type': 'ListItem', position: 2, name: 'Piscinas', item: 'https://depofibra.com/piscinas/' },
        { '@type': 'ListItem', position: 3, name: model.shortName, item: canonical },
      ],
    })} />
  </Fragment>

  <div class="pool-page" data-pool-name={model.shortName}>
    <div class="container">
      <nav class="pool-breadcrumb" aria-label="Migas de pan">
        <a href="/piscinas/">← Volver a piscinas</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{model.shortName}</span>
      </nav>

      <section class="pool-top" aria-labelledby="pool-name">
        <div class="pool-gallery" aria-label={`Galería de fotos de ${model.shortName}`}>
          <div class="pool-gallery__stage">
            <div class="pool-gallery__viewport" tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Fotografías de la piscina. Desliza lateralmente para ver las demás.">
              <div class="pool-gallery__track">
                {model.gallery.map((photo, i) => (
                  <figure class="pool-gallery__slide" aria-label={`Foto ${i + 1} de ${model.gallery.length}`}>
                    <img src={photo.src} alt={photo.alt} width="1200" height="900" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                  </figure>
                ))}
              </div>
            </div>
            {model.gallery.length > 1 && <>
              <button type="button" class="pool-gallery__arrow pool-gallery__arrow--prev" aria-label="Ver fotografía anterior" data-pool-prev>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <button type="button" class="pool-gallery__arrow pool-gallery__arrow--next" aria-label="Ver fotografía siguiente" data-pool-next>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </>}
            <span class="pool-gallery__counter" aria-live="polite">1 / {model.gallery.length}</span>
          </div>
          {model.gallery.length > 1 && <div class="pool-gallery__thumbs" role="group" aria-label="Elegir fotografía">
            {model.gallery.map((photo, i) => (
              <button type="button" class:list={['pool-gallery__thumb', {'is-current':i===0}]} aria-label={`Mostrar foto ${i + 1}: ${photo.alt}`} aria-pressed={i === 0 ? 'true' : 'false'}>
                <img src={photo.src} alt="" width="90" height="90" loading="lazy" />
              </button>
            ))}
          </div>}
          <p class="pool-gallery__note">Fotografías facilitadas como referencia. El modelo y sus características definitivas se confirman antes del presupuesto.</p>
        </div>

        <div class="pool-summary">
          <span class="pool-eyebrow">PISCINAS DE POLIÉSTER <span aria-hidden="true">·</span> DEPOFIBRA</span>
          <h1 id="pool-name">{model.name}</h1>
          <p class="pool-summary__lead">{model.intro}</p>
          <div class="pool-summary__specs">
            <div><span>Medida del lote</span><strong>{model.measure}</strong></div>
            <div><span>Profundidad</span><strong>A confirmar</strong></div>
          </div>
          <div class="pool-summary__trust">
            <p><span aria-hidden="true">✓</span> Te ayudamos a consultar el modelo adecuado</p>
            <p><span aria-hidden="true">✓</span> Revisión del transporte según destino y accesos</p>
            <p><span aria-hidden="true">✓</span> Atención comercial desde Casariche (Sevilla)</p>
          </div>
          <div class="pool-summary__contact">
            <h2>¿Te interesa esta piscina?</h2>
            <p>Escríbenos o llámanos. No necesitas rellenar un formulario ni conocer las características técnicas.</p>
            <div class="pool-actions">
              <a class="pool-btn pool-btn--wa" href={whatsappHref} target="_blank" rel="noopener noreferrer">
                <WhatsAppIcon size={20} />
                Consultar por WhatsApp <span aria-hidden="true">↗</span>
              </a>
              <a class="pool-btn pool-btn--contact" href={contactHref}>Pedir presupuesto <span aria-hidden="true">↗</span></a>
            </div>
            <a class="pool-call" href="tel:+34642129233">¿Prefieres hablar? <strong>642 129 233</strong> ↗</a>
          </div>
          {model.measureConflict && <p class="pool-summary__notice">Importante: este lote fotográfico figura como 7 × 3 m; otra referencia anterior indicaba 7,1 × 3 m. Confirmaremos la medida antes de cotizar.</p>}
        </div>
      </section>

      <section class="pool-information" aria-label="Información sobre esta piscina">
        <div class="pool-tabs" role="tablist" aria-label="Detalles de la piscina">
          <button class="pool-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="pool-panel-description" id="pool-tab-description" tabindex="0">Descripción</button>
          <button class="pool-tab" type="button" role="tab" aria-selected="false" aria-controls="pool-panel-measures" id="pool-tab-measures" tabindex="-1">Medidas y equipamiento</button>
          <button class="pool-tab" type="button" role="tab" aria-selected="false" aria-controls="pool-panel-delivery" id="pool-tab-delivery" tabindex="-1">Entrega e instalación</button>
        </div>
        <div class="pool-panel" role="tabpanel" id="pool-panel-description" aria-labelledby="pool-tab-description" tabindex="0">
          <div><span class="pool-eyebrow">SOBRE ESTA REFERENCIA</span><h2>Una opción para valorar en tu espacio.</h2></div>
          <div><p>{model.intro}</p><p>En Depofibra comercializamos piscinas prefabricadas de poliéster según el modelo y las condiciones de suministro. Las fotografías te permiten conocer el aspecto general de la referencia y comparar su formato antes de consultarnos.</p><p>Antes de confirmar una propuesta comprobaremos el modelo que corresponde, la documentación técnica aplicable y las condiciones de transporte.</p></div>
        </div>
        <div class="pool-panel" role="tabpanel" id="pool-panel-measures" aria-labelledby="pool-tab-measures" tabindex="0" hidden>
          <div><span class="pool-eyebrow">DIMENSIONES</span><h2>Confirma las medidas antes de decidir.</h2></div>
          <div>
            <dl class="pool-measures"><div><dt>Medida del lote fotográfico</dt><dd>{model.measure}</dd></div><div><dt>Profundidad</dt><dd>Pendiente de confirmar</dd></div><div><dt>Escalones y equipamiento</dt><dd>Según referencia</dd></div></dl>
            <p>Estos datos sirven para iniciar la consulta, pero no sustituyen la ficha técnica. Deben revisarse las medidas interiores y exteriores, la profundidad, el acceso y los elementos incluidos.</p>
            {model.measureConflict && <p>En la documentación histórica existía una referencia de 7,1 × 3 m. La clasificación de las fotografías indica 7 × 3 m; esta diferencia está pendiente de comprobación.</p>}
          </div>
        </div>
        <div class="pool-panel" role="tabpanel" id="pool-panel-delivery" aria-labelledby="pool-tab-delivery" tabindex="0" hidden>
          <div><span class="pool-eyebrow">ANTES DEL PRESUPUESTO</span><h2>Revisa cómo llegará a tu parcela.</h2></div>
          <div><ol class="pool-steps"><li><strong>Comprueba el espacio</strong><p>Mide el lugar disponible y la zona de maniobra para la instalación.</p></li><li><strong>Indica el destino</strong><p>Facilita localidad y código postal, además de cualquier limitación de acceso.</p></li><li><strong>Confirma el suministro</strong><p>Transporte, descarga, montaje y accesorios no deben suponerse incluidos sin confirmación expresa.</p></li></ol></div>
        </div>
      </section>

      <section class="pool-related" aria-labelledby="pool-related-title">
        <div class="pool-related__heading">
          <div><span class="pool-eyebrow">MÁS PISCINAS</span><h2 id="pool-related-title">Otros modelos que pueden interesarte</h2></div>
          <a href="/piscinas/">Ver todas las piscinas ↗</a>
        </div>
        <div class="pool-related__grid">
          {related.map(item => (
            <a href={`/piscinas/${item.slug}/`} class="pool-related__item">
              <span class="pool-related__media"><img src={item.gallery[0].src} alt={item.gallery[0].alt} loading="lazy" width="360" height="280" /></span>
              <strong>{item.shortName} <span aria-hidden="true">↗</span></strong>
              <small>Consultar modelo y presupuesto</small>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.pool-page').forEach(root => {
    const viewport = root.querySelector<HTMLElement>('.pool-gallery__viewport');
    const slides = [...root.querySelectorAll<HTMLElement>('.pool-gallery__slide')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.pool-gallery__thumb')];
    const counter = root.querySelector<HTMLElement>('.pool-gallery__counter');
    const thumbsScroller = root.querySelector<HTMLElement>('.pool-gallery__thumbs');
    let current = 0;
    let frame = 0;
    const setCurrent = (index: number) => {
      current = Math.max(0, Math.min(index, slides.length - 1));
      buttons.forEach((button, i) => {
        const active = current === i;
        button.classList.toggle('is-current', active);
        button.setAttribute('aria-pressed', String(active));
      });
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    };
    const navigate = (index: number) => {
      if (!viewport || !slides.length) return;
      const next = (index + slides.length) % slides.length;
      viewport.scrollTo({ left: next * viewport.clientWidth, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      setCurrent(next);
      const thumb = buttons[next];
      if (thumb && thumbsScroller) {
        const left = Math.max(0, thumb.offsetLeft - (thumbsScroller.clientWidth - thumb.offsetWidth) / 2);
        thumbsScroller.scrollTo({ left, behavior:'smooth' });
      }
    };
    root.querySelector('[data-pool-prev]')?.addEventListener('click', () => navigate(current - 1));
    root.querySelector('[data-pool-next]')?.addEventListener('click', () => navigate(current + 1));
    buttons.forEach((button, index) => button.addEventListener('click', () => navigate(index)));
    viewport?.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        if (!viewport?.clientWidth) return;
        const index = Math.round(viewport.scrollLeft / viewport.clientWidth);
        if (index !== current) setCurrent(index);
      });
    }, { passive: true });
    viewport?.addEventListener('keydown', event => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      navigate(current + (event.key === 'ArrowRight' ? 1 : -1));
    });
    if (viewport && 'ResizeObserver' in window) {
      new ResizeObserver(() => viewport.scrollTo({ left:current * viewport.clientWidth,behavior:'auto' })).observe(viewport);
    }
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.pool-tab')];
    const activateTab = (selected: HTMLButtonElement, focus = false) => {
      tabs.forEach(button => {
        const active = button === selected;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
        const panel = button.getAttribute('aria-controls');
        const node = panel ? document.getElementById(panel) : null;
        if (node) node.hidden = !active;
      });
      if (focus) selected.focus();
    };
    tabs.forEach((button, index) => {
      button.addEventListener('click', () => activateTab(button));
      button.addEventListener('keydown', event => {
        if (!['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length-1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        activateTab(tabs[next], true);
      });
    });
  });
</script>

<style>
  .pool-page{background:#fff;color:var(--color-dark);padding:0 0 clamp(45px,6vw,78px)}
  .pool-breadcrumb{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:22px 0 25px;color:#788595;font:600 12px/1.5 var(--font-body)}
  .pool-breadcrumb a{color:var(--color-primary-dark)}.pool-breadcrumb a:hover{color:var(--color-primary)}
  .pool-top{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);align-items:start;gap:clamp(30px,5vw,74px)}
  .pool-gallery{min-width:0;width:100%;max-width:clamp(420px,35vw,560px)}
  .pool-gallery__stage{width:100%;aspect-ratio:1/1;position:relative;border-radius:18px;overflow:hidden;background:#f6f8fa}
  .pool-gallery__viewport{height:100%;width:100%;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
  .pool-gallery__viewport::-webkit-scrollbar{display:none}
  .pool-gallery__viewport:focus-visible{outline:3px solid var(--color-primary);outline-offset:-3px}
  .pool-gallery__track{display:flex;width:100%;height:100%}
  .pool-gallery__slide{height:100%;flex:0 0 100%;min-width:0;display:grid;place-items:center;scroll-snap-align:start;margin:0}
  .pool-gallery__slide img{display:block;width:100%;height:100%;object-fit:contain;object-position:center}
  .pool-gallery__arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:44px;height:44px;border:1px solid #e1e8f1;border-radius:50%;background:rgba(255,255,255,.96);display:grid;place-items:center;color:var(--color-primary-dark);cursor:pointer;transition:background .2s}
  .pool-gallery__arrow:hover{background:#eaf2fb}.pool-gallery__arrow--prev{left:12px}.pool-gallery__arrow--next{right:12px}
  .pool-gallery__counter{position:absolute;right:14px;bottom:14px;z-index:2;background:rgba(255,255,255,.95);border-radius:999px;padding:7px 11px;color:#536779;font:600 11px/1.4 var(--font-body)}
  .pool-gallery__thumbs{display:flex;gap:10px;margin-top:12px;overflow-x:auto;scrollbar-width:thin;padding:2px 1px 8px;scroll-snap-type:x proximity}
  .pool-gallery__thumb{flex:0 0 auto;width:78px;height:78px;display:grid;place-items:center;border:1px solid #e0e7ef;border-radius:10px;background:#fff;overflow:hidden;cursor:pointer;scroll-snap-align:start}
  .pool-gallery__thumb.is-current{border-color:var(--color-primary);box-shadow:0 0 0 1px var(--color-primary)}
  .pool-gallery__thumb img{width:100%;height:100%;object-fit:contain}
  .pool-gallery__note{color:#708092;font:400 11px/1.6 var(--font-body);margin-top:10px;max-width:64ch}
  .pool-eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--color-primary);font:800 11px/1.5 var(--font-display);letter-spacing:.09em;text-transform:uppercase}
  .pool-eyebrow::before{content:'';width:6px;height:6px;background:var(--color-primary);border-radius:50%}
  .pool-summary{padding-top:5px}
  .pool-summary h1{margin:14px 0 16px;font:800 clamp(2.05rem,3.5vw,3.45rem)/1.08 var(--font-display);letter-spacing:-.055em;color:#101a2e;text-wrap:balance}
  .pool-summary__lead{color:#4b5b70;font:400 clamp(14px,1.12vw,16px)/1.75 var(--font-body);max-width:57ch}
  .pool-summary__specs{display:flex;gap:clamp(24px,3vw,52px);flex-wrap:wrap;border-block:1px solid #e4eaf0;padding:15px 0;margin:22px 0}
  .pool-summary__specs div{display:grid;gap:2px}.pool-summary__specs span{color:#788595;font:500 12px/1.5 var(--font-body)}.pool-summary__specs strong{color:#26394e;font:700 14px/1.5 var(--font-body)}
  .pool-summary__trust{display:grid;gap:8px;margin-bottom:23px}.pool-summary__trust p{display:flex;gap:10px;color:#40586f;font:500 13px/1.5 var(--font-body)}.pool-summary__trust p>span{color:var(--color-primary);font-weight:800}
  .pool-summary__contact{border-top:1px solid #e4eaf0;padding-top:20px}.pool-summary__contact h2{font:800 18px/1.3 var(--font-display);letter-spacing:-.03em;color:#12243a}.pool-summary__contact>p{color:#67788b;font:400 13px/1.6 var(--font-body);margin:6px 0 16px}
  .pool-actions{display:grid;grid-template-columns:1.15fr 1fr;gap:11px}.pool-btn{min-height:52px;padding:10px 16px;display:inline-flex;align-items:center;justify-content:center;gap:10px;border-radius:999px;border:1px solid transparent;white-space:nowrap;font:800 13px/1.3 var(--font-display);transition:transform .2s ease,background .2s ease}.pool-btn:hover{transform:translateY(-2px)}.pool-btn svg{width:20px;height:20px;flex:0 0 auto}.pool-btn--wa{background:#25d366;color:#083621}.pool-btn--wa:hover{background:#1ebe59}.pool-btn--contact{border-color:#b7ccdf;color:var(--color-primary-dark)}.pool-btn--contact:hover{background:#eaf2fb}
  .pool-call{display:inline-flex;align-items:center;gap:5px;margin-top:14px;color:#53687b;font:500 13px/1.5 var(--font-body)}.pool-call strong{color:var(--color-primary);font-weight:800}.pool-summary__notice{margin-top:17px;padding:12px 0;border-top:1px solid #e4eaf0;color:#53687b;font:500 12px/1.7 var(--font-body)}
  .pool-information{margin-top:clamp(52px,6vw,78px);border-top:1px solid #dfe6ed}
  .pool-tabs{display:flex;gap:30px;border-bottom:1px solid #dfe6ed;overflow-x:auto;scrollbar-width:none}.pool-tabs::-webkit-scrollbar{display:none}
  .pool-tab{background:transparent;min-height:58px;padding:14px 2px;border:0;border-bottom:2px solid transparent;color:#718092;white-space:nowrap;flex:0 0 auto;cursor:pointer;font:700 14px/1.4 var(--font-body)}.pool-tab:hover{color:var(--color-primary)}.pool-tab.is-active{border-bottom-color:var(--color-primary);color:var(--color-primary-dark)}
  .pool-panel{display:grid;grid-template-columns:minmax(190px,.64fr) minmax(0,1.12fr);gap:clamp(25px,5vw,74px);padding:32px 0 45px}.pool-panel[hidden]{display:none}.pool-panel h2{margin:12px 0 0;max-width:18ch;color:#162a41;font:800 clamp(1.6rem,2.6vw,2.25rem)/1.14 var(--font-display);letter-spacing:-.045em}.pool-panel p{color:#536477;font:400 15px/1.8 var(--font-body);margin-bottom:14px}
  .pool-measures{display:grid;gap:0;border-top:1px solid #dfe6ed;margin-bottom:18px}.pool-measures div{display:grid;grid-template-columns:1fr 1fr;gap:12px;border-bottom:1px solid #dfe6ed;padding:13px 0;font:600 14px/1.5 var(--font-body)}.pool-measures dt{color:#718092}.pool-measures dd{color:var(--color-dark);font-weight:800}
  .pool-steps{list-style:none}.pool-steps li{padding:12px 0;border-bottom:1px solid #e3eaf0}.pool-steps strong{font:800 14px/1.4 var(--font-display)}
  .pool-related{border-top:1px solid #dfe6ed;padding-top:34px}.pool-related__heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.pool-related__heading h2{margin-top:10px;font:800 clamp(1.5rem,2.5vw,2.15rem)/1.15 var(--font-display);letter-spacing:-.045em}.pool-related__heading>a{color:var(--color-primary);font:700 13px/1.4 var(--font-body);white-space:nowrap}
  .pool-related__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.pool-related__item{min-width:0}.pool-related__media{display:block;aspect-ratio:1/1;overflow:hidden;background:#f6f8fa;border-radius:13px}.pool-related__media img{display:block;width:100%;height:100%;object-fit:contain}.pool-related__item strong{display:flex;justify-content:space-between;gap:8px;margin-top:12px;color:#162a41;font:800 14px/1.4 var(--font-display)}.pool-related__item strong span{color:var(--color-primary)}.pool-related__item small{display:block;color:#6c7b8b;margin-top:5px;font:500 12px/1.5 var(--font-body)}
  @media(max-width:1100px){.pool-top{gap:26px}.pool-actions{grid-template-columns:1fr}.pool-summary h1{font-size:clamp(2rem,3.7vw,2.7rem)}}
  @media(max-width:850px){.pool-top{grid-template-columns:1fr;max-width:650px;margin-inline:auto}.pool-gallery{max-width:none}.pool-actions{grid-template-columns:1fr 1fr}.pool-panel{grid-template-columns:1fr;gap:18px}.pool-related__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:580px){.pool-breadcrumb{padding:14px 0 17px}.pool-gallery__stage{border-radius:12px}.pool-gallery__arrow{width:38px;height:38px}.pool-gallery__arrow--prev{left:8px}.pool-gallery__arrow--next{right:8px}.pool-gallery__thumb{width:66px;height:66px}.pool-summary h1{margin:10px 0 11px;font-size:clamp(1.95rem,8vw,2.45rem)}.pool-summary__specs{margin:17px 0;padding:12px 0}.pool-summary__trust{margin-bottom:17px}.pool-actions{grid-template-columns:1fr}.pool-btn{min-height:50px}.pool-information{margin-top:45px}.pool-tabs{gap:22px}.pool-tab{font-size:12px;min-height:52px}.pool-panel{padding:26px 0 35px}.pool-related__heading{display:block}.pool-related__heading>a{display:inline-flex;margin-top:12px}.pool-related__grid{gap:15px 10px}.pool-related__item strong{font-size:12px}}
  @media(prefers-reduced-motion:reduce){.pool-btn{transition:none}}
</style>
