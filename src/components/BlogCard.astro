---
import type { BlogArticle } from '../data/blogArticles';
import { blogPhotos } from '../data/blogPhotos';
interface Props { article: BlogArticle; compact?: boolean; }
const { article, compact = false } = Astro.props;
const photo = blogPhotos[article.slug];
---
<article class:list={['df-blog-card', {'df-blog-card--compact':compact}]}>
  <a class="df-blog-card__image" href={`/blog/${article.slug}/`} aria-label={`Leer: ${article.title}`}>
    <img src={photo.src} alt={photo.alt} data-fallback={photo.fallback} loading="lazy" width="900" height="610" decoding="async" />
    <span class="df-blog-card__arrow" aria-hidden="true">↗</span>
  </a>
  <div class="df-blog-card__content">
    <span class="df-blog-card__category">{article.category}</span>
    <h3><a href={`/blog/${article.slug}/`}>{article.title}</a></h3>
    <p>{article.summary}</p>
    <div class="df-blog-card__end"><span>{article.reading}</span><a href={`/blog/${article.slug}/`}>Leer guía <span aria-hidden="true">↗</span></a></div>
  </div>
</article>
<style>
  .df-blog-card{min-width:0;border:1px solid #e7ebf0;border-radius:17px;overflow:hidden;background:#fff;transition:transform .24s ease,border-color .24s ease}
  .df-blog-card:hover{transform:translateY(-3px);border-color:#cbdbe8}
  .df-blog-card__image{position:relative;display:block;aspect-ratio:1.7;overflow:hidden;background:#eaf2fb}
  .df-blog-card__image img{width:100%;height:100%;object-fit:cover;transition:transform .48s ease}
  .df-blog-card__image:hover img{transform:scale(1.04)}
  .df-blog-card__arrow{position:absolute;bottom:13px;right:13px;width:35px;height:35px;display:grid;place-items:center;background:#fff;color:#01488e;border-radius:100%;font-weight:800;font-size:19px}
  .df-blog-card__content{padding:19px 19px 16px}
  .df-blog-card__category{font:800 10px/1.3 var(--font-display);letter-spacing:.08em;text-transform:uppercase;color:#01488e}
  .df-blog-card h3{font:800 clamp(17px,1.55vw,20px)/1.3 var(--font-display);letter-spacing:-.032em;color:#0f172a;margin:9px 0}
  .df-blog-card h3 a:hover{color:#01488e}
  .df-blog-card p{font:400 13px/1.67 var(--font-body);color:#64748b;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;min-height:65px}
  .df-blog-card__end{border-top:1px solid #edf0f3;margin-top:17px;padding-top:13px;display:flex;align-items:center;justify-content:space-between;gap:12px}
  .df-blog-card__end>span{font:500 11px var(--font-body);color:#8191a0}
  .df-blog-card__end a{font:800 12px var(--font-display);color:#01488e;white-space:nowrap}
  .df-blog-card__end a:hover{text-decoration:underline;text-underline-offset:4px}
  @media(min-width:1000px){.df-blog-card--compact .df-blog-card__image{aspect-ratio:1.9}}
  @media(max-width:640px){.df-blog-card__content{padding:18px}.df-blog-card p{min-height:0}.df-blog-card__image{aspect-ratio:1.85}}
  @media(prefers-reduced-motion:reduce){.df-blog-card,.df-blog-card__image img{transition:none}}
</style>
