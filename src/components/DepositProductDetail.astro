---
import WhatsAppIcon from './WhatsAppIcon.astro';
import Layout from '../layouts/Layout.astro';
import { depositFamilies, type DepositFamily } from '../data/depositProducts';
import { getDepositDimensions } from '../data/depositDimensions';

interface Props { product: DepositFamily; }
const { product } = Astro.props;
const related = depositFamilies.filter(item => item.slug !== product.slug).slice(0, 4);
const canonical = `https://depofibra.com/depositos/${product.slug}/`;
const firstImage = product.gallery[0];
const dimensionSheet = getDepositDimensions(product.slug);
const formatDimension = (value: number) => new Intl.NumberFormat('es-ES').format(value);
const featuredLiters = [5000, 10000, 15000];
const featuredRows = dimensionSheet?.rows.filter((row) => featuredLiters.includes(row.liters)) ?? [];
const hasFeaturedRows = product.slug === 'vertical-base-plana' && featuredRows.length > 0;
// Número de contacto publicado para WhatsApp en la web anterior. Se puede sobrescribir en .env.
const whatsappNumber = String(import.meta.env.PUBLIC_WHATSAPP_NUMBER || '34642129233').replace(/\D/g, '');
const quoteMessage = (item: string) => `Hola, quisiera solicitar presupuesto de ${item}. ¿Podéis orientarme sobre disponibilidad de referencia y transporte? Mi código postal es: `;
const whatsappHref = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(quoteMessage(product.quoteProduct))}`
  : '';
const contactHref = `/contacto/?producto=${encodeURIComponent(product.quoteProduct)}`;
---
<Layout title={product.titleSeo} description={product.metaDescription} canonical={canonical} activeNav="depositos" ogImage={firstImage.src}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://depofibra.com/' },
        { '@type': 'ListItem', position: 2, name: 'Depósitos', item: 'https://depofibra.com/depositos/' },
        { '@type': 'ListItem', position: 3, name: product.shortName, item: canonical },
      ],
    })} />
  </Fragment>

  <main class="product-page" data-product-name={product.quoteProduct} data-whatsapp-number={whatsappNumber}>
    <div class="container">
      <nav class="product-breadcrumb" aria-label="Migas de pan">
        <a href="/depositos/">← Volver a depósitos</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{product.shortName}</span>
      </nav>

      <section class="product-intro" aria-labelledby="product-name">
        <div class="product-gallery">
          <div class="product-gallery__stage">
            <div
              class="product-gallery__viewport"
              tabindex="0"
              role="region"
              aria-roledescription="carrusel"
              aria-label={`Fotografías del producto ${product.shortName}. Desliza horizontalmente para cambiar de foto.`}
            >
              <div class="product-gallery__track">
                {product.gallery.map((image, index) => (
                  <figure class="product-gallery__slide" aria-label={`Fotografía ${index + 1} de ${product.gallery.length}`} style={`--gallery-photo:url("${image.src}")`}>
                    <img
                      src={image.src}
                      alt={image.alt}
                      width="1000"
                      height="1000"
                      loading={index === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      fetchpriority={index === 0 ? 'high' : 'auto'}
                    />
                  </figure>
                ))}
              </div>
            </div>
            {product.gallery.length > 1 && (
              <>
                <button class="product-gallery__arrow product-gallery__arrow--prev" type="button" aria-label="Ver fotografía anterior" data-gallery-prev>
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                </button>
                <button class="product-gallery__arrow product-gallery__arrow--next" type="button" aria-label="Ver fotografía siguiente" data-gallery-next>
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                </button>
              </>
            )}
            <span class="product-gallery__caption" aria-live="polite">{firstImage.kind}</span>
            <span class="product-gallery__counter" aria-live="polite">1 / {product.gallery.length}</span>
          </div>
          {product.gallery.length > 1 && (
            <div class="product-gallery__thumbs" role="group" aria-label="Seleccionar fotografía">
              {product.gallery.map((image, index) => (
                <button class:list={['product-gallery__thumb', { 'is-current': index === 0 }]} type="button" aria-label={`Mostrar fotografía ${index + 1} de ${product.gallery.length}: ${image.alt}`} aria-pressed={index === 0 ? 'true' : 'false'} data-kind={image.kind}>
                  <img src={image.src} alt="" width="96" height="96" loading="lazy" />
                </button>
              ))}
            </div>
          )}
          <p class="product-gallery__note">Imágenes orientativas. Las características de la referencia se comprueban antes de presupuestar.</p>
        </div>

        <div class="product-summary">
          <span class="product-eyebrow">DEPÓSITOS DE POLIÉSTER <span aria-hidden="true">·</span> DEPOFIBRA</span>
          <h1 id="product-name">{product.name}</h1>
          <p class="product-summary__lead">{product.intro}</p>

          <div class="product-summary__specs" aria-label="Datos generales">
            <div><span>Formato</span><strong>{product.geometry}</strong></div>
            <div><span>Instalación</span><strong>{product.installation}</strong></div>
          </div>

          <div class="product-summary__trust">
            <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg> Orientación según el uso y la instalación</p>
            <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg> Estudio del transporte según destino</p>
            <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg> Atención comercial desde Casariche (Sevilla)</p>
          </div>

          <div class="product-summary__contact" aria-label="Solicitar presupuesto">
            <p class="product-summary__contact-title">¿Encaja con lo que buscas?</p>
            <p class="product-summary__contact-help">Indícanos la capacidad aproximada y el código postal. Te ayudamos a concretar la referencia.</p>
            <div class="product-actions">
              {whatsappHref ? (
                <a class="product-button product-button--whatsapp" href={whatsappHref} target="_blank" rel="noopener noreferrer" data-wa-cta>
                  <WhatsAppIcon size={20} />
                  Consultar por WhatsApp
                  <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <a class="product-button product-button--whatsapp product-button--pending" href={contactHref} title="WhatsApp pendiente de conectar: mientras tanto, utiliza Contacto" data-wa-cta>
                  <WhatsAppIcon size={20} />
                  Consultar por WhatsApp
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              <a class="product-button product-button--contact" href={contactHref} data-contact-cta>
                Pedir presupuesto <span aria-hidden="true">↗</span>
              </a>
            </div>
            {!whatsappHref && <p class="product-summary__pending">WhatsApp pendiente de activar: por ahora este acceso te lleva a Contacto.</p>}
          </div>
        </div>
      </section>

      <section class="product-quickhelp" aria-labelledby="product-quickhelp-heading">
        <div class="product-quickhelp__lead">
          <span class="product-eyebrow">ANTES DE PEDIR PRESUPUESTO</span>
          <h2 id="product-quickhelp-heading">Qué conviene tener claro</h2>
          <p>Cuanto más concreto sea el dato de partida, más fácil será orientar la referencia y el transporte. En depósitos, lo más útil suele ser indicar litros aproximados, uso, código postal y condicionantes del acceso.</p>
        </div>
        <div class="product-quickhelp__grid">
          <article><strong>Capacidad</strong><p>Indica los litros aproximados que necesitas. Si estás comparando varias opciones, menciona el rango.</p></article>
          <article><strong>Uso previsto</strong><p>No todos los formatos encajan igual. Es importante saber para qué se va a utilizar y qué líquido contendrá.</p></article>
          <article><strong>Destino y acceso</strong><p>El código postal y cualquier limitación de acceso ayudan a valorar el transporte antes del presupuesto.</p></article>
          <article><strong>Instalación</strong><p>Si irá en superficie, enterrado o con necesidades especiales, conviene indicarlo desde el inicio.</p></article>
        </div>
        {hasFeaturedRows && (
          <div class="product-featured">
            <div class="product-featured__head">
              <div>
                <span class="product-eyebrow">CAPACIDADES DE REFERENCIA</span>
                <h3>Tres capacidades para comparar</h3>
              </div>
              <p>Referencias orientativas de 5.000, 10.000 y 15.000 litros. Las medidas pueden variar según modelo y deben confirmarse con la ficha vigente antes del pedido.</p>
            </div>
            <div class="product-featured__grid">
              {featuredRows.map((row) => (
                <article>
                  <span>{formatDimension(row.liters)} L</span>
                  <strong>Ø {formatDimension(row.diameterMm)} mm</strong>
                  <p>Cota de ficha: {formatDimension(row.longitudinalMm)} mm</p>
                </article>
              ))}
            </div>
          </div>
        )}
      </section>

      <section class="product-information" aria-label="Información del depósito">
        <div class="product-tabs" role="tablist" aria-label="Detalles del producto">
          <button type="button" class="product-tab is-active" role="tab" aria-selected="true" aria-controls="product-panel-description" id="product-tab-description" tabindex="0">Descripción</button>
          <button type="button" class="product-tab" role="tab" aria-selected="false" aria-controls="product-panel-capacity" id="product-tab-capacity" tabindex="-1">Capacidades y medidas</button>
          <button type="button" class="product-tab" role="tab" aria-selected="false" aria-controls="product-panel-installation" id="product-tab-installation" tabindex="-1">Instalación y entrega</button>
        </div>

        <div class="product-panel" id="product-panel-description" role="tabpanel" aria-labelledby="product-tab-description" tabindex="0">
          <div class="product-panel__title"><span class="product-eyebrow">SOBRE ESTE DEPÓSITO</span><h2>Conoce las características del formato.</h2></div>
          <div class="product-panel__body">
            {product.description.map(paragraph => <p>{paragraph}</p>)}
            <ul class="product-highlights">{product.highlights.map(item => <li><strong>{item.title}</strong><span>{item.text}</span></li>)}</ul>
          </div>
        </div>

        <div class="product-panel" id="product-panel-capacity" role="tabpanel" aria-labelledby="product-tab-capacity" tabindex="0" hidden>
          <div class="product-panel__title"><span class="product-eyebrow">PARA TU INSTALACIÓN</span><h2>Capacidades y medidas.</h2></div>
          <div class="product-panel__body">
            {dimensionSheet ? (
              <>
                <p>Consulta las medidas orientativas de la ficha facilitada para este tipo de depósito. La referencia, los accesorios y las dimensiones definitivas deben confirmarse antes de presupuestar.</p>
                <p class="product-dimensions__hint">Pulsa sobre una capacidad para indicar el modelo y sus medidas en tu solicitud.</p>
                <div class="product-dimensions__wrap">
                  <table class="product-dimensions" aria-label={`Tabla de capacidades y medidas de ${product.shortName}`}>
                    <thead>
                      <tr>
                        <th scope="col">Litros</th>
                        <th scope="col">Diámetro<br /><small>mm</small></th>
                        <th scope="col">{dimensionSheet.mode === 'vertical' ? 'Cota de ficha*' : 'Longitud'}<br /><small>mm</small></th>
                        {dimensionSheet.mode === 'surface-horizontal' && <th scope="col">Cunas</th>}
                      </tr>
                    </thead>
                    <tbody>
                      {dimensionSheet.rows.map((dimension) => {
                        const selected = `${product.quoteProduct} — ${formatDimension(dimension.liters)} L · diámetro ${formatDimension(dimension.diameterMm)} mm · ${dimensionSheet.mode === 'vertical' ? 'cota de ficha' : 'longitud'} ${formatDimension(dimension.longitudinalMm)} mm${dimensionSheet.mode === 'surface-horizontal' ? ` · cunas ${dimension.supports}` : ''}`;
                        return (
                          <tr>
                            <th scope="row"><button class="product-dimensions__choose" type="button" data-product-variation={selected} aria-pressed="false" title="Seleccionar esta referencia para consultar presupuesto">{formatDimension(dimension.liters)} L</button></th>
                            <td>{formatDimension(dimension.diameterMm)}</td>
                            <td>{formatDimension(dimension.longitudinalMm)}</td>
                            {dimensionSheet.mode === 'surface-horizontal' && <td>{dimension.supports}</td>}
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
                {dimensionSheet.mode === 'vertical' && (
                  <p class="product-dimensions__disclaimer">* La tabla facilitada identifica esta dimensión como «longitud». Consulta la altura total del depósito vertical, incluida la boca de acceso, antes de planificar el espacio.</p>
                )}
                {dimensionSheet.mode === 'surface-horizontal' && (
                  <p class="product-dimensions__disclaimer">El número de cunas procede de la tabla de referencia y puede requerir confirmación de la configuración suministrada.</p>
                )}
                {dimensionSheet.mode === 'buried-horizontal' && (
                  <p class="product-dimensions__disclaimer">Medidas tomadas por equivalencia de la tabla de horizontales con cunas, según indicación de Depofibra. Esto no significa que un depósito de superficie pueda enterrarse: la referencia enterrable y sus condiciones de instalación deben verificarse expresamente.</p>
                )}
                <p class="product-dimensions__selected" data-size-selected hidden aria-live="polite"></p>
                <a class="product-dimensions__quote" href={contactHref} data-contact-measures>Solicitar presupuesto de este depósito <span aria-hidden="true">↗</span></a>
              </>
            ) : (
              <>
                <p>Las capacidades y las medidas se consultan según el modelo, el uso y la configuración solicitada. No hay una tabla única confirmada para este formato.</p>
                <p class="product-capacities__note">Indícanos los litros aproximados y, si procede, las características de las patas metálicas u otros apoyos que necesitas.</p>
              </>
            )}
            <label class="product-capacity-custom" for="product-custom-capacity">Otra capacidad aproximada (opcional)
              <input type="number" id="product-custom-capacity" name="capacidad" min="1" step="1" inputmode="numeric" placeholder="Ej.: 8.000 litros" />
            </label>
          </div>
        </div>

        <div class="product-panel" id="product-panel-installation" role="tabpanel" aria-labelledby="product-tab-installation" tabindex="0" hidden>
          <div class="product-panel__title"><span class="product-eyebrow">ANTES DE RECIBIRLO</span><h2>Una entrega bien preparada.</h2></div>
          <div class="product-panel__body">
            <ol class="product-install-steps">{product.installationPoints.map((point, index) => <li><span>{String(index + 1).padStart(2,'0')}</span><div><strong>{point.title}</strong><p>{point.text}</p></div></li>)}</ol>
            <p class="product-install-note">El transporte estándar no incluye la descarga, salvo condición expresa confirmada. Es importante prever los medios adecuados.</p>
          </div>
        </div>
      </section>

      <section class="product-related" aria-labelledby="product-related-heading">
        <div class="product-related__head"><div><span class="product-eyebrow">DESCUBRE MÁS OPCIONES</span><h2 id="product-related-heading">Otros depósitos que pueden interesarte</h2></div><a href="/depositos/">Ver el catálogo completo <span aria-hidden="true">↗</span></a></div>
        <div class="product-related__grid">{related.map(item => <a href={`/depositos/${item.slug}/`} class="product-related__item"><span class="product-related__image" style={`--related-photo:url("${item.gallery[0].src}")`}><img src={item.gallery[0].src} alt={item.gallery[0].alt} width="420" height="320" loading="lazy" /></span><span class="product-related__name">{item.shortName}<span aria-hidden="true">↗</span></span><small>{item.installation}</small></a>)}</div>
      </section>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.product-page').forEach(root => {
    const galleryViewport = root.querySelector<HTMLElement>('.product-gallery__viewport');
    const gallerySlides = Array.from(root.querySelectorAll<HTMLElement>('.product-gallery__slide'));
    const galleryButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.product-gallery__thumb'));
    const thumbsScroller = root.querySelector<HTMLElement>('.product-gallery__thumbs');
    const prevImage = root.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const nextImage = root.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const caption = root.querySelector<HTMLElement>('.product-gallery__caption');
    const counter = root.querySelector<HTMLElement>('.product-gallery__counter');
    let currentImageIndex = 0;
    let galleryScrollFrame = 0;

    // El carrusel usa desplazamiento horizontal nativo: funciona con el dedo en móvil.
    // Las flechas y las miniaturas mantienen sincronizada la fotografía seleccionada.
    const updateGalleryUI = (index: number) => {
      currentImageIndex = Math.max(0, Math.min(index, gallerySlides.length - 1));
      galleryButtons.forEach((button, buttonIndex) => {
        const active = buttonIndex === currentImageIndex;
        button.classList.toggle('is-current', active);
        button.setAttribute('aria-pressed', String(active));
      });
      if (prevImage) prevImage.disabled = gallerySlides.length <= 1;
      if (nextImage) nextImage.disabled = gallerySlides.length <= 1;
      if (caption) caption.textContent = galleryButtons[currentImageIndex]?.dataset.kind || '';
      if (counter) counter.textContent = `${currentImageIndex + 1} / ${gallerySlides.length}`;
    };

    const navigateGallery = (index: number, smooth = true) => {
      if (!galleryViewport || gallerySlides.length === 0) return;
      const safeIndex = ((index % gallerySlides.length) + gallerySlides.length) % gallerySlides.length;
      galleryViewport.scrollTo({ left: safeIndex * galleryViewport.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
      updateGalleryUI(safeIndex);
      const thumb = galleryButtons[safeIndex];
      if (thumb && thumbsScroller) {
        const left = Math.max(0, thumb.offsetLeft - (thumbsScroller.clientWidth - thumb.offsetWidth) / 2);
        thumbsScroller.scrollTo({ left, behavior: smooth ? 'smooth' : 'auto' });
      }
    };

    galleryButtons.forEach((button, index) => button.addEventListener('click', () => navigateGallery(index)));
    prevImage?.addEventListener('click', () => navigateGallery(currentImageIndex - 1));
    nextImage?.addEventListener('click', () => navigateGallery(currentImageIndex + 1));
    galleryViewport?.addEventListener('scroll', () => {
      if (galleryScrollFrame) cancelAnimationFrame(galleryScrollFrame);
      galleryScrollFrame = requestAnimationFrame(() => {
        if (!galleryViewport || !galleryViewport.clientWidth) return;
        const index = Math.round(galleryViewport.scrollLeft / galleryViewport.clientWidth);
        if (index !== currentImageIndex) {
          updateGalleryUI(index);
        }
      });
    }, { passive: true });
    galleryViewport?.addEventListener('keydown', event => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      navigateGallery(currentImageIndex + (event.key === 'ArrowRight' ? 1 : -1));
    });
    if (galleryViewport && 'ResizeObserver' in window) {
      new ResizeObserver(() => galleryViewport.scrollTo({ left: currentImageIndex * galleryViewport.clientWidth, behavior: 'auto' })).observe(galleryViewport);
    }

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.product-tab'));
    function activateTab(tab: HTMLButtonElement, focus = false) {
      tabs.forEach(item => {
        const active = item === tab;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
        item.tabIndex = active ? 0 : -1;
        const target = item.getAttribute('aria-controls');
        const panel = target ? document.getElementById(target) : null;
        if(panel) panel.hidden = !active;
      });
      if(focus) tab.focus();
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(tab));
      tab.addEventListener('keydown', event => {
        if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        activateTab(tabs[next], true);
      });
    });

    const whatsapp = root.querySelector<HTMLAnchorElement>('[data-wa-cta]');
    const contact = root.querySelector<HTMLAnchorElement>('[data-contact-cta]');
    const dimensionsContact = root.querySelector<HTMLAnchorElement>('[data-contact-measures]');
    const sizeSelected = root.querySelector<HTMLElement>('[data-size-selected]');
    const variationButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-product-variation]'));
    const customInput = root.querySelector<HTMLInputElement>('#product-custom-capacity');
    const base = root.dataset.productName || '';
    const number = root.dataset.whatsappNumber || '';
    let selectedProduct = base;
    const updateLinks = () => {
      const custom = customInput?.value.trim();
      const validCustom = custom && Number(custom) > 0 && Number.isFinite(Number(custom));
      const productText = validCustom ? `${base} — ${Math.round(Number(custom)).toLocaleString('es-ES')} litros` : selectedProduct;
      const contactUrl = new URL('/contacto/', window.location.origin);
      contactUrl.searchParams.set('producto', base);
      if (productText !== base) contactUrl.searchParams.set('capacidad', productText.replace(base, '').replace(/^\s*[—-]\s*/, '').trim());
      if (contact) contact.href = contactUrl.pathname + contactUrl.search;
      if (dimensionsContact) dimensionsContact.href = contactUrl.pathname + contactUrl.search;
      if(whatsapp) {
        if(number) {
          const text = `Hola, quisiera solicitar presupuesto de ${productText}. ¿Podéis orientarme sobre la referencia y el transporte? Mi código postal es: `;
          whatsapp.href = `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
        } else {
          whatsapp.href = contactUrl.pathname + contactUrl.search;
        }
      }
    };
    variationButtons.forEach(button => button.addEventListener('click', () => {
      variationButtons.forEach(item => {const active=item===button; item.classList.toggle('is-selected',active); item.setAttribute('aria-pressed',String(active));});
      selectedProduct = button.dataset.productVariation || base;
      root.querySelectorAll('tr.is-selected').forEach(row => row.classList.remove('is-selected'));
      const row = button.closest('tr');
      if (row) row.classList.add('is-selected');
      if (sizeSelected) { sizeSelected.hidden = !row; sizeSelected.textContent = row ? `Has seleccionado: ${selectedProduct.replace(`${base} — `, '')}` : ''; }
      if(customInput) customInput.value = '';
      updateLinks();
    }));
    customInput?.addEventListener('input', () => {
      variationButtons.forEach(item => {item.classList.remove('is-selected'); item.setAttribute('aria-pressed','false');});
      selectedProduct = base;
      root.querySelectorAll('tr.is-selected').forEach(row => row.classList.remove('is-selected'));
      if (sizeSelected) { sizeSelected.hidden = true; sizeSelected.textContent = ''; }
      updateLinks();
    });
  });
</script>

<style>
  .product-page{padding:0 0 clamp(48px,6vw,80px);background:#fff;color:var(--color-dark)}
  .product-breadcrumb{display:flex;gap:14px;align-items:center;flex-wrap:wrap;padding:22px 0 25px;font:600 12px/1.5 var(--font-body);color:#788595}
  .product-breadcrumb a{color:var(--color-primary-dark);transition:color .2s}.product-breadcrumb a:hover{color:var(--color-primary)}
  .product-intro{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);gap:clamp(35px,5vw,75px);align-items:start}
  /* Todas las fotografías de depósito se muestran en un lienzo cuadrado uniforme, sin marco visible. */
  .product-gallery{min-width:0}
  /* Limita el tamaño en portátil para que la foto completa entre mejor en pantalla. */
  .product-gallery{width:100%;max-width:clamp(430px,35vw,560px);min-width:0}
  .product-gallery__stage{width:100%;aspect-ratio:1 / 1;position:relative;border-radius:18px;background:transparent;overflow:hidden}
