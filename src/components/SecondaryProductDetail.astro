---
import WhatsAppIcon from './WhatsAppIcon.astro';
/**
 * Ficha informativa compartida para Fosas y Cubas.
 * Mantiene la identidad de las fichas actuales sin atribuir datos no confirmados.
 */
import Layout from '../layouts/Layout.astro';
import { secondaryProducts, type SecondaryProduct } from '../data/secondaryProducts';

interface Props { product: SecondaryProduct }
const { product } = Astro.props;
const isFosa = product.family === 'fosas';
const path = isFosa ? '/fosas-septicas/' : '/cubas-cisternas/';
const categoryName = isFosa ? 'Fosas sépticas' : 'Cubas y cisternas';
const canonical = `https://depofibra.com${path}${product.slug}/`;
const related = secondaryProducts.filter(item => item.family === product.family && item.slug !== product.slug);
const whatsappNumber = String(import.meta.env.PUBLIC_WHATSAPP_NUMBER || '34642129233').replace(/\D/g, '');
const whatsappMessage = `Hola, quisiera información y presupuesto de ${product.title.toLowerCase()}. ¿Podéis confirmar la referencia y el transporte hasta mi localidad?`;
const whatsappHref = whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}` : '/contacto/';
---
<Layout
  title={product.titleSeo}
  description={product.metaDescription}
  canonical={canonical}
  ogImage={product.image}
  ogImageAlt={product.imageAlt}
  activeNav={product.family}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://depofibra.com/' },
        { '@type': 'ListItem', position: 2, name: categoryName, item: `https://depofibra.com${path}` },
        { '@type': 'ListItem', position: 3, name: product.title, item: canonical },
      ],
    })} />
  </Fragment>
  <div class="secondary-page">
    <div class="container">
      <nav class="secondary-breadcrumb" aria-label="Migas de pan">
        <a href={path}>← Volver a {categoryName.toLowerCase()}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{product.title}</span>
      </nav>

      <section class="secondary-top" aria-labelledby="secondary-name">
        <div class="secondary-photo">
          <img src={product.image} alt={product.imageAlt} loading="eager" decoding="async" width={isFosa ? 900 : 1600} height={isFosa ? 1220 : 1200} />
          <p>Fotografía de referencia compartida por la familia de {categoryName.toLowerCase()}. No identifica necesariamente el modelo seleccionado.</p>
        </div>
        <div class="secondary-summary">
          <span class="secondary-eyebrow">{product.eyebrow} · DEPOFIBRA</span>
          <h1 id="secondary-name">{product.title}</h1>
          <p class="secondary-lead">{product.summary}</p>
          <div class="secondary-text">
            <h2>Información sobre esta opción</h2>
            <p>{product.details}</p>
            <p>{isFosa
              ? 'La capacidad, los habitantes equivalentes, la documentación del equipo y las condiciones de vertido deben validarse según el proyecto y el fabricante.'
              : 'Las medidas, la capacidad, los apoyos y cualquier accesorio deben confirmarse en el modelo ofertado. El vehículo o remolque no se consideran incluidos.'}
            </p>
          </div>
          <div class="secondary-contact">
            <h2>¿Necesitas un presupuesto?</h2>
            <p>Indícanos el uso previsto y la localidad de entrega. Revisaremos la referencia y las condiciones de suministro.</p>
            <div class="secondary-actions">
              <button class="secondary-button secondary-button--primary open-quote-trigger" type="button" data-product={product.quoteProduct} data-note={`Referencia consultada: ${product.title}`}>Pedir presupuesto <span aria-hidden="true">↗</span></button>
              <a class="secondary-button secondary-button--outline" href={whatsappHref} target="_blank" rel="noopener noreferrer"><WhatsAppIcon size={20} /> Consultar por WhatsApp <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </section>

      <section class="secondary-related" aria-labelledby="secondary-related-heading">
        <div class="secondary-related__heading">
          <h2 id="secondary-related-heading">Otras opciones de {categoryName.toLowerCase()}</h2>
          <a href={path}>Ver el catálogo completo <span aria-hidden="true">↗</span></a>
        </div>
        <div class="secondary-related__links">
          {related.map(item => <a href={`${path}${item.slug}/`}>{item.title}<span aria-hidden="true">↗</span></a>)}
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .secondary-page{background:#fff;color:var(--color-dark);padding-bottom:clamp(50px,6vw,78px)}
  .secondary-breadcrumb{display:flex;align-items:center;flex-wrap:wrap;gap:13px;padding:22px 0 25px;color:#788595;font:600 12px/1.5 var(--font-body)}
  .secondary-breadcrumb a{color:var(--color-primary-dark)}.secondary-breadcrumb a:hover{color:var(--color-primary)}
  .secondary-top{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);gap:clamp(25px,5vw,74px);align-items:start}
  .secondary-photo{min-width:0;max-width:560px}
  .secondary-photo img{width:100%;max-height:560px;object-fit:contain;display:block}
  .secondary-photo p{margin:11px 0 0;color:#708092;font:400 11px/1.65 var(--font-body);max-width:62ch}
  .secondary-summary{min-width:0;padding-top:5px}
  .secondary-eyebrow{display:block;color:var(--color-primary);font:800 11px/1.5 var(--font-display);letter-spacing:.075em;text-transform:uppercase}
  .secondary-summary h1{margin:14px 0 16px;font:800 clamp(2.05rem,3.5vw,3.4rem)/1.08 var(--font-display);letter-spacing:-.055em;color:#101a2e;text-wrap:balance}
  .secondary-lead{color:#4b5b70;font:400 clamp(14px,1.15vw,16px)/1.75 var(--font-body)}
  .secondary-text{border-top:1px solid #e4eaf0;margin-top:24px;padding-top:21px}
  .secondary-text h2,.secondary-contact h2{margin:0 0 10px;color:#12243a;font:800 18px/1.3 var(--font-display);letter-spacing:-.02em}
  .secondary-text p,.secondary-contact p{margin:0 0 14px;color:#536477;font:400 14px/1.8 var(--font-body)}
  .secondary-contact{border-top:1px solid #e4eaf0;margin-top:23px;padding-top:22px}
  .secondary-actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:17px}
  .secondary-button{min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:13px;padding:11px 18px;border-radius:999px;white-space:normal;font:800 13px/1.3 var(--font-display);cursor:pointer;text-align:center;transition:background .2s ease,color .2s ease}
  .secondary-button--primary{color:#fff;background:var(--color-primary);border:1px solid var(--color-primary)}
  .secondary-button--primary:hover{background:var(--color-primary-dark)}
  .secondary-button--outline{background:#fff;color:var(--color-primary);border:1px solid #b7ccdf}
  .secondary-button--outline:hover{background:#eaf2fb}
  .secondary-related{border-top:1px solid #dfe6ed;margin-top:clamp(55px,6vw,85px);padding-top:29px}
  .secondary-related__heading{display:flex;align-items:end;justify-content:space-between;gap:20px}
  .secondary-related__heading h2{font:800 clamp(20px,2.5vw,28px)/1.2 var(--font-display);color:#12243a;letter-spacing:-.04em}
  .secondary-related__heading>a{font:700 13px/1.4 var(--font-body);color:var(--color-primary)}
  .secondary-related__links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;margin-top:22px}
  .secondary-related__links a{display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid #dfe6ed;padding:17px 0;color:#26394e;font:800 15px/1.35 var(--font-display)}
  .secondary-related__links a:hover{color:var(--color-primary)}
  .secondary-related__links a span{color:var(--color-primary)}
  @media(max-width:850px){.secondary-top{grid-template-columns:1fr;max-width:650px;margin-inline:auto}.secondary-photo{max-width:none}.secondary-related__heading{display:block}.secondary-related__heading>a{display:inline-flex;margin-top:10px}}
  @media(max-width:580px){.secondary-breadcrumb{padding:15px 0 17px}.secondary-photo img{max-height:440px}.secondary-summary h1{font-size:clamp(1.95rem,8vw,2.45rem)}.secondary-related__links{grid-template-columns:1fr;gap:0}.secondary-related__links a{font-size:14px}.secondary-button{width:100%}}
  @media(prefers-reduced-motion:reduce){.secondary-button{transition:none}}
</style>
