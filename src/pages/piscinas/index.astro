---
import CategoryInterior from '../../components/CategoryInterior.astro';
import { poolModels } from '../../data/poolModels';
const page = {
  "nav": "piscinas",
  "title": "Piscinas de poliéster",
  "seoTitle": "Piscinas prefabricadas de poliéster por medidas | Depofibra",
  "eyebrow": "PISCINAS PREFABRICADAS",
  "description": "Piscinas prefabricadas de poliéster de 3 × 2 a 7 × 3 m como referencia. Compara fotografías y medidas, y consulta modelo, transporte y presupuesto con Depofibra.",
  "intro": "Compara las medidas de referencia y encuentra la piscina para tu espacio. Te ayudamos a confirmar el modelo y solicitar presupuesto.",
  "items": poolModels.map((model) => ({
    id: model.slug,
    name: model.shortName,
    specification: "PISCINA DE POLIÉSTER",
    subtitle: "Medida de referencia: " + model.measure + ". Consulta características y presupuesto.",
    image: model.gallery[0].src,
    href: `/piscinas/${model.slug}/`,
    visualType: "photo",
    tags: [],
    detail: model.intro,
    quoteProduct: "Piscina",
    quoteNote: `Piscina ${model.measure} (modelo y dimensiones a confirmar)`,
  })),
  "note": "Fotografías aportadas para mostrar las cinco referencias por medida. Las medidas, profundidades, accesorios y disponibilidad deben confirmarse antes de presupuestar; la carpeta de 7 × 3 m difiere de la referencia histórica de 7,1 × 3 m.",
  "guideTitle": "Antes de elegir una piscina de poliéster",
  "guideDescription": "Un presupuesto útil empieza por comprobar que el vaso puede transportarse y acceder a la parcela, además de encajar en el espacio disponible.",
  "guideRows": [
    {
      "title": "Mide la zona de instalación",
      "detail": "Comprueba el espacio disponible para el vaso y el entorno de obra, incluidos los accesos y maniobras. La medida nominal no sustituye al plano del modelo concreto."
    },
    {
      "title": "Compara profundidad y configuración",
      "detail": "No basta con conocer largo y ancho. Deben verificarse profundidad, forma interior, escalera, conexiones y equipamiento de la referencia propuesta."
    },
    {
      "title": "Revisa entrega, descarga y montaje",
      "detail": "La viabilidad del transporte y los medios de descarga dependen de dimensiones, ubicación y condiciones de acceso. No se presupone instalación ni descarga incluidas."
    }
  ],
  "faqs": [
    {
      "question": "¿Puedo solicitar una piscina de 3 × 2 metros?",
      "answer": "Sí, puedes consultarnos por la medida 3 × 2 m que aparece en las fotografías. Antes de darte presupuesto confirmaremos la referencia vigente, sus medidas reales y el equipamiento disponible."
    },
    {
      "question": "¿Las medidas mostradas son definitivas?",
      "answer": "Las medidas identifican los lotes de fotografías, no sustituyen una ficha técnica. Las dimensiones exteriores, profundidad, escalones y equipamiento se confirmarán antes de presupuestar. En el lote grande aparece 7 × 3 m y en una referencia antigua, 7,1 × 3 m."
    },
    {
      "question": "¿Podéis estudiar transporte hasta mi localidad?",
      "answer": "Sí. Se puede consultar según modelo, destino y acceso. Es útil indicar código postal, ancho de paso, posibles obstáculos y medios de descarga."
    },
    {
      "question": "¿La instalación está incluida?",
      "answer": "No podemos darla por incluida sin confirmación expresa. El alcance del suministro, transporte, descarga, montaje y accesorios se detallará en cada presupuesto."
    },
    {
      "question": "¿Cómo pido presupuesto de una piscina?",
      "answer": "Indica la medida que te interesa o el espacio disponible, la localidad y cualquier limitación de acceso. Con esos datos podremos revisar modelos vigentes y condiciones."
    }
  ]
};
---
<CategoryInterior {...page} />
