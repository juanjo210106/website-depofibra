<!-- V17 · Progreso por scroll en «Tres datos que facilitan la entrega» -->
<script>
  const stepList = document.querySelector<HTMLOListElement>('[data-logistics-steps]');
  if (stepList) {
    const steps = Array.from(stepList.querySelectorAll<HTMLElement>('[data-logistics-step]'));
    const current = document.querySelector<HTMLElement>('[data-logistics-current]');
    const progress = document.querySelector<HTMLElement>('[data-logistics-progress]');
    const desktop = window.matchMedia('(min-width: 900px)');
    let lastActive = -1;
    let pending = false;

    const paintStep = () => {
      pending = false;
      if (!desktop.matches || !steps.length) return;
      const targetY = Math.max(210, Math.min(window.innerHeight * 0.46, 460));
      let active = 0;
      let bestDistance = Number.POSITIVE_INFINITY;
      steps.forEach((step, index) => {
        const rect = step.getBoundingClientRect();
        const midpoint = rect.top + rect.height * 0.5;
        const distance = Math.abs(midpoint - targetY);
        if (distance < bestDistance) { bestDistance = distance; active = index; }
      });
      if (active === lastActive) return;
      lastActive = active;
      steps.forEach((step, index) => step.classList.toggle('is-active', index === active));
      if (current) current.textContent = String(active + 1).padStart(2, '0');
      if (progress) progress.style.width = `${((active + 1) / steps.length) * 100}%`;
    };
    const requestPaint = () => {
      if (!pending) { pending = true; window.requestAnimationFrame(paintStep); }
    };
    const onBreakpointChange = () => {
      if (!desktop.matches) {
        steps.forEach(step => step.classList.remove('is-active'));
        lastActive = -1;
      } else { requestPaint(); }
    };
    window.addEventListener('scroll', requestPaint, { passive: true });
    window.addEventListener('resize', requestPaint, { passive: true });
    desktop.addEventListener('change', onBreakpointChange);
    requestPaint();
  }
</script>


<!-- V20 · FAQ: un solo acordeón abierto entre las dos columnas. -->
<script>
  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('#preguntas-frecuentes .faq__item'));
  // `name` permite el comportamiento nativo; este listener sirve de refuerzo
  // en navegadores que aún no gestionan grupos de <details>.
  faqItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!item.open) return;
      faqItems.forEach((other) => {
        if (other !== item && other.open) other.open = false;
      });
    });
  });
</script>
