    .logistics__header h2 { margin-bottom: 0; }
    .logistics__visual { min-height: 495px; }
    .logistics__visual img { object-position: center 55%; }
    .logistics__visual-card { width: min(465px, calc(100% - 60px)); margin: 0 0 28px 28px; padding: 27px 29px; }
    .logistics__details {
      grid-template-columns: minmax(250px, .82fr) minmax(0, 1.18fr);
      align-items: start;
      gap: clamp(45px, 7vw, 120px);
