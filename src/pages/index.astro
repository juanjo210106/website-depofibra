  }
  .logistics__photo-cta svg { width: 17px; height: 17px; transition: transform .23s ease; }
  .logistics__photo-cta:hover { background: var(--color-primary-dark); transform: translateY(-2px); }
  .logistics__photo-cta:hover svg { transform: translateX(3px) rotate(-13deg); }
  .logistics__photo-cta:focus-visible { outline: 3px solid #70b7ff; outline-offset: 3px; }
