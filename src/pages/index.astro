  }

  /* ═══════════════════════════════════════
     PREGUNTAS FRECUENTES — dos columnas editoriales y acordeones accesibles
     ═══════════════════════════════════════ */
  .faq { background: #fff; }
  .faq__layout { display: grid; grid-template-columns: 1fr; gap: 29px; }
  .faq__intro { max-width: 830px; margin-inline: auto; text-align: center; }
  .faq__intro .eyebrow { justify-content: center; }
  .faq__intro h2 { margin: 14px auto 14px; max-width: 830px; text-wrap: balance; }
  .faq__intro > .body-lg { margin-inline: auto; max-width: 670px; font-size: 16px; line-height: 1.8; }
  .faq__list { display: grid; grid-template-columns: 1fr; gap: 12px 24px; }
  .faq__column { display: grid; grid-auto-rows: min-content; align-content: start; gap: 10px; min-width: 0; }
  .faq__item { min-width: 0; border-radius: 12px; border: 1px solid #e5ebf2; background: #f5f7fa; overflow: clip; transition: border-color .2s ease, background .2s ease; }
  .faq__item summary {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 34px;
    gap: 10px;
    min-height: 66px;
    align-items: center;
    padding: 12px 14px;
    font: 750 14px/1.4 var(--font-display);
    letter-spacing: -.012em;
    color: var(--color-dark);
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::before { content: '•'; font: 800 16px/1 var(--font-display); color: var(--color-primary); text-align: center; }
  .faq__item summary::after {
    content: '+';
    display: grid;
    place-items: center;
    justify-self: end;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid #cbddec;
    color: var(--color-primary);
    background: #fff;
    font: 500 22px/1 var(--font-body);
    transition: background .2s ease, transform .2s ease, color .2s ease;
  }
  .faq__item summary:focus-visible { outline: 3px solid #6bb3ed; outline-offset: -3px; }
  .faq__item summary:hover { color: var(--color-primary); }
  .faq__item summary:hover::after { transform: rotate(90deg); }
  .faq__item[open] { background: #f3f7fb; border-color: #b9d2e9; }
  .faq__item[open] summary { background: var(--color-primary); color: #fff; }
  .faq__item[open] summary::before { color: #c9e7ff; }
  .faq__item[open] summary::after { content: '−'; color: var(--color-primary); background: #fff; border-color: #fff; }
  .faq__item[open] summary:hover { color: #fff; }
  .faq__answer { padding: 17px 18px 20px; color: var(--color-gray-600); }
  .faq__answer p { max-width: 75ch; font-size: 14px; line-height: 1.8; }
  .faq__help {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
    padding: 20px 0 0;
    border-top: 1px solid var(--color-gray-200);
    text-align: center;
    align-items: center;
  }
  .faq__help-index { display: none; }
  .faq__help p { margin: 0; color: var(--color-gray-600); font-size: 14px; line-height: 1.6; }
  .faq__help p strong { color: var(--color-dark); }
  .faq__help-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 3px 0 0;
    padding: 5px 2px;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: var(--color-primary);
    font: 750 13px/1.5 var(--font-display);
    cursor: pointer;
  }
  .faq__help-link svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; transition: transform .2s ease; }
  .faq__help-link:hover svg { transform: translateX(3px); }
  .faq__help-link:focus-visible { outline: 3px solid #6bb3ed; outline-offset: 4px; }
  @media (min-width: 820px) {
    .faq__layout { gap: 39px; }
    .faq__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 22px; }
    .faq__item summary { font-size: 14px; }
    .faq__help { flex-direction: row; justify-content: center; gap: 24px; }
  }
  @media (max-width: 599px) {
    .faq__layout { gap: 22px; }
    .faq__intro h2 { margin: 12px auto; }
    .faq__item summary { grid-template-columns: 18px minmax(0,1fr) 32px; gap: 8px; padding: 12px 10px; font-size: 13px; }
    .faq__answer { padding: 16px 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq__item, .faq__item summary::after, .faq__help-link svg { transition: none; }
  }

  /* V18 — clarificar que estas capacidades son una muestra, no todo el catálogo. */
  .capacities__highlight { color: var(--color-primary); }
  .capacities__all {
    display: inline-flex; align-items: center; gap: 12px; margin-top: 22px;
    color: var(--color-primary); font: 800 14px/1.5 var(--font-display);
    text-decoration: none; border-bottom: 1px solid #b8d2ea; padding-bottom: 7px;
  }
  .capacities__all:hover { border-bottom-color: var(--color-primary); }

  /* V18 — guía editorial más visual, sin el recuadro azul genérico. */
  .guide__visual {
    position: relative;
    overflow: visible;
    border: 0;
    padding: 0;
    border-radius: 0;
    background: transparent;
  }
  .guide__visual-heading { border-left: 3px solid var(--color-primary); padding: 3px 0 4px 20px; }
  .guide__visual-heading strong { max-width: 470px; font-size: clamp(24px,2.4vw,35px); line-height: 1.15; }
  .guide__visual img {
    width: 100%; max-height: 460px; aspect-ratio: 1.35;
    margin: 21px 0 0; object-fit: contain;
    background: #f2f6fb; border-radius: 20px 20px 0 0;
    mix-blend-mode: normal;
  }
  .guide__visual-foot {
    display: grid; grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 0; padding: 0; margin: 0; border: 1px solid #d8e5ef;
    border-top: 0; border-radius: 0 0 20px 20px; overflow: hidden;
  }
  .guide__visual-foot a {
    display: grid; grid-template-columns: 1fr auto; gap: 7px;
    padding: 16px 13px; text-decoration: none;
    color: var(--color-primary); font: 800 11px/1.4 var(--font-display);
    background: #fff; border-right: 1px solid #e1ebf3;
    transition: background .2s ease;
  }
  .guide__visual-foot a:last-child { border-right: 0; }
  .guide__visual-foot a strong { grid-column: 1 / -1; font: 700 13px/1.4 var(--font-display); color: var(--color-dark); }
  .guide__visual-foot a span { grid-column: 2; grid-row: 1; }
  .guide__visual-foot a:hover { background: #eaf2fb; }
  .guide__visual-foot span::before { display: none; }
  .guide__visual-caption { margin: 13px 0 0; }
