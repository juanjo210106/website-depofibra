  /* V17 — scroll editorial: números protagonistas, sin tarjetas ni ornamentación. */
  .logistics__details {
    display: grid;
    gap: 32px;
    padding-top: 44px;
    margin-top: 31px;
    border-top: 1px solid var(--color-gray-200);
