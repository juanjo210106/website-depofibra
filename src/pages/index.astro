    .logistics__visual-card p { font-size: 15px; }
    .logistics__photo-cta { width: 100%; }
    .logistics__photo-note { left: 14px; right: 14px; bottom: 17px; font-size: 9px; }
    .logistics__details { padding-top: 27px; margin-top: 25px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .logistics__photo-cta, .logistics__photo-cta svg,
    .logistics__steps li, .logistics__step-number, .logistics__steps li > div,
    .logistics__progress-track span { transition: none !important; transform: none !important; }
  }

  /* ═══════════════════════════════════════
     GUÍA PARA ELEGIR — sección editorial y producto
     ═══════════════════════════════════════ */
  .guide {
    background: #fff;
    border-top: 1px solid var(--color-gray-200);
  }

  .guide__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }

  .guide__content { min-width: 0; }
  .guide__content h2 {
    margin: 15px 0 18px;
    max-width: 660px;
    text-wrap: balance;
  }
  .guide__intro { max-width: 700px; }
  .guide__intro strong { font-weight: 700; color: var(--color-dark); }

  .guide__steps {
    margin: 30px 0 27px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-gray-200);
  }
  .guide__step {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 17px;
    padding: 18px 0 19px;
    border-bottom: 1px solid var(--color-gray-200);
  }
  .guide__step-num {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid #d7e5f3;
