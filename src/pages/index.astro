    .logistics__steps li.is-active .logistics__step-number { color: var(--color-primary); transform: translateX(5px); }
    .logistics__steps h4 { font-size: clamp(20px, 2vw, 29px); }
    .logistics__steps li > div { transform: translateY(6px); transition: transform .45s var(--ease-out); }
    .logistics__steps li.is-active > div { transform: translateY(0); }
  }
  @media (max-width: 600px) {
    .logistics__header { gap: 12px; }
    .logistics__visual { min-height: 520px; border-radius: 19px; }
