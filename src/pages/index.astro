  }
  .guide__quote {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 52px;
    padding: 8px 9px 8px 20px;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-size: 14px;
