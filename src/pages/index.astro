  .logistics { background: var(--color-gray-50); }
  .logistics__header { display: grid; gap: 15px; margin-bottom: 30px; }
  .logistics__header h2 { margin: 12px 0 0; max-width: 750px; text-wrap: balance; }
  .logistics__header .body-lg { max-width: 810px; margin: 0; color: var(--color-gray-600); }
  .logistics__header .body-lg strong { color: var(--color-gray-700); font-weight: 650; }

  .logistics__visual {
