---
/**
 * DEPOFIBRA — PÁGINA DE INICIO
 * Home completa mobile-first con todas las secciones del prompt maestro.
 *
 * NOTA SOBRE FOTOGRAFÍAS:
 * - Las imágenes de /images/productos/ son fotografías aportadas por el propietario.
 *   La imagen deposito-vertical.jpg contiene la marca "DecaSur" del fabricante.
 *   No se elimina para no atribuir fabricación a Depofibra.
 *   Antes de publicar, confirmar autorización de uso web.
 * - Las imágenes de Unsplash son contextuales/ambientales, con licencia verificable.
 */
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import CategoryShowcase from '../components/CategoryShowcase.astro';
---

<Layout
  title="Depósitos de poliéster para agua y riego | Depofibra"
  description="Depósitos de poliéster para agua y riego: consulta modelos verticales, horizontales y enterrables. También piscinas, fosas y cubas, con presupuesto según destino."
  ogImage="/images/depositos/vertical-base-plana/deposito-poliester-vertical-base-plana-blanco-escala-frontal.webp"
  ogImageAlt="Depósito vertical blanco de poliéster con escala de nivel, fotografía de referencia"
  activeNav="inicio"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://depofibra.com/#organization",
          "name": "Depofibra",
          "url": "https://depofibra.com/",
          "description": "Comercialización de depósitos de poliéster reforzado con fibra de vidrio (PRFV), piscinas prefabricadas, fosas sépticas, cubas y cisternas.",
          "telephone": "+34 642 129 233",
          "email": "depofibra21@gmail.com",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Casariche",
            "addressRegion": "Sevilla",
            "addressCountry": "ES"
          },
          "sameAs": [
            "https://www.instagram.com/depofibra/",
            "https://www.facebook.com/profile.php?id=61589529128415"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://depofibra.com/#website",
          "url": "https://depofibra.com/",
          "name": "Depofibra",
          "inLanguage": "es-ES",
          "publisher": { "@id": "https://depofibra.com/#organization" }
        },
        {
          "@type": "WebPage",
          "@id": "https://depofibra.com/#webpage",
          "url": "https://depofibra.com/",
          "name": "Depósitos de poliéster para agua y riego | Depofibra",
          "inLanguage": "es-ES",
          "isPartOf": { "@id": "https://depofibra.com/#website" },
          "about": { "@id": "https://depofibra.com/#organization" }
        },
        {
          "@type": "ItemList",
          "@id": "https://depofibra.com/#catalogo-principal",
          "name": "Familias de productos de Depofibra",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Depósitos de poliéster", "url": "https://depofibra.com/depositos/" },
            { "@type": "ListItem", "position": 2, "name": "Piscinas de poliéster", "url": "https://depofibra.com/piscinas/" },
            { "@type": "ListItem", "position": 3, "name": "Fosas sépticas", "url": "https://depofibra.com/fosas-septicas/" },
            { "@type": "ListItem", "position": 4, "name": "Cubas y cisternas", "url": "https://depofibra.com/cubas-cisternas/" }
          ]
        }
      ]
    })} />
  </Fragment>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 1 — HERO DE CATEGORÍAS (CARRUSEL)
       ═══════════════════════════════════════════════ -->
  <HeroCarousel />


  <!-- CATÁLOGO VISUAL — 4 familias verificadas -->
  <CategoryShowcase />

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 3 — DEPÓSITOS PRIORITARIOS
       ═══════════════════════════════════════════════ -->
  <section class="capacities section" id="depositos-5000-10000-15000" aria-labelledby="capacities-heading">
    <div class="container">
      <div class="capacities__layout">
        <div class="capacities__intro">
          <span class="eyebrow">Tres ejemplos de capacidad · Catálogo completo</span>
          <h2 class="heading-lg" id="capacities-heading">Tres capacidades habituales. <span class="capacities__highlight">Muchas más opciones.</span></h2>
          <p class="body-lg">
            Los depósitos verticales de base plana se pueden consultar en distintas capacidades. <strong>5.000, 10.000 y 15.000 litros son solo tres ejemplos frecuentes, no las únicas opciones.</strong> Si necesitas otro volumen, lo estudiamos según modelo, uso y espacio disponible.
          </p>
          <a href="/depositos/" class="capacities__explore">
            Explorar depósitos verticales
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
        </div>

        <div class="capacities__table" role="list" aria-label="Comparativa de depósitos de 5.000, 10.000 y 15.000 litros">
          <div class="capacities__row" role="listitem">
            <div class="capacities__amount">
              <strong>5.000 <span>L</span></strong>
              <span>5 m³ de capacidad nominal</span>
            </div>
            <p>Consulta dimensiones, altura de instalación y posición de las conexiones.</p>
          </div>

          <div class="capacities__row" role="listitem">
            <div class="capacities__amount">
              <strong>10.000 <span>L</span></strong>
              <span>10 m³ de capacidad nominal</span>
            </div>
            <p>Comprueba diámetro, accesos de entrega y conexiones según el uso.</p>
          </div>

          <div class="capacities__row" role="listitem">
            <div class="capacities__amount">
              <strong>15.000 <span>L</span></strong>
              <span>15 m³ de capacidad nominal</span>
            </div>
            <p>Revisa el espacio para la instalación y los medios de descarga necesarios.</p>
          </div>
          <p class="capacities__note">Estos ejemplos no representan el catálogo completo. Dimensiones, equipamiento y condiciones sujetos a confirmación de cada referencia.</p>
          <button class="capacities__quote open-quote-trigger" data-product="Depósito vertical de base plana" type="button">
            <span>Consultar capacidad y pedir presupuesto</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </button>
          <a class="capacities__all" href="/depositos/">¿Buscas otra capacidad? Explora todos los tipos de depósitos <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 4 — LOGÍSTICA Y ENTREGA
       ═══════════════════════════════════════════════ -->
  <section class="logistics section" id="logistica" aria-labelledby="logistics-heading">
    <div class="container">
      <div class="logistics__header">
        <div class="logistics__heading">
          <span class="eyebrow">Transporte y entrega</span>
          <h2 class="heading-lg" id="logistics-heading">Transporte de depósitos de poliéster: presupuesto según destino</h2>
        </div>
        <p class="body-lg">¿Necesitas un depósito de agua con entrega en tu localidad? Estudiamos el transporte de depósitos de poliéster en España y Portugal según el modelo, sus dimensiones, el código postal y los accesos. <strong>La descarga no está incluida en el transporte estándar.</strong></p>
      </div>

      <div class="logistics__visual">
        <img
          src="/images/depositos/horizontal-con-cunas/deposito-poliester-horizontal-con-cunas-blanco-en-transporte.webp"
          alt="Depósito horizontal de poliéster cargado en un vehículo de transporte"
          loading="lazy"
          decoding="async"
          width="1448"
          height="1448"
        />
        <div class="logistics__visual-overlay" aria-hidden="true"></div>
        <div class="logistics__visual-card">
          <span class="logistics__visual-eyebrow">Consulta de transporte</span>
          <h3>Tu depósito, con el destino claro desde el principio</h3>
          <p>Dinos qué modelo buscas y dónde hay que entregarlo. Comprobaremos las opciones de suministro y las condiciones logísticas antes de preparar el presupuesto.</p>
          <button class="logistics__photo-cta open-quote-trigger" type="button">
            Consultar precio con entrega
            <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </button>
        </div>
        <span class="logistics__photo-note">Fotografía de un depósito en transporte · No implica transporte propio de Depofibra</span>
      </div>

      <div class="logistics__details">
        <div class="logistics__details-intro">
          <span class="eyebrow">Antes de solicitar presupuesto</span>
          <h3 class="heading-sm">Tres datos que facilitan la entrega</h3>
          <p class="body-md">Con esta información podemos estudiar el transporte y evitar incidencias al recibir el depósito.</p>
          <div class="logistics__progress" aria-hidden="true">
            <div class="logistics__progress-counter"><strong data-logistics-current>01</strong><span>/ 03</span></div>
            <div class="logistics__progress-track"><span data-logistics-progress></span></div>
            <span class="logistics__progress-caption">Desliza para descubrir los tres pasos</span>
          </div>
        </div>
        <ol class="logistics__steps" data-logistics-steps>
          <li data-logistics-step class="is-active">
            <span class="logistics__step-number" aria-hidden="true">01</span>
            <div><h4>Modelo y capacidad</h4><p>Indica el tipo de depósito y sus litros. Las medidas de la referencia concreta condicionan el transporte.</p></div>
          </li>
          <li data-logistics-step>
            <span class="logistics__step-number" aria-hidden="true">02</span>
            <div><h4>Localidad y accesos</h4><p>Facilita el código postal y cualquier limitación de acceso para el vehículo de entrega.</p></div>
          </li>
          <li data-logistics-step>
            <span class="logistics__step-number" aria-hidden="true">03</span>
            <div><h4>Medios de descarga</h4><p>El transporte estándar no incluye descarga: prepara los medios adecuados conforme al producto y las indicaciones del fabricante.</p></div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 5 — GUÍA PARA ELEGIR: orientación práctica
       ═══════════════════════════════════════════════ -->
  <section class="guide section" id="guia-eleccion" aria-labelledby="guide-heading">
    <div class="container">
      <div class="guide__layout">
        <div class="guide__content">
          <span class="eyebrow">Antes de elegir tu depósito</span>
          <h2 class="heading-lg" id="guide-heading">Cómo elegir un depósito de poliéster para tu instalación</h2>
          <p class="body-lg guide__intro">
            Antes de comparar precios, conviene definir <strong>qué vas a almacenar, cuántos litros necesitas y dónde lo instalarás</strong>. Estos cuatro puntos te ayudarán a identificar el modelo adecuado y solicitar un presupuesto más preciso.
          </p>

          <ol class="guide__steps">
            <li class="guide__step">
              <span class="guide__step-num" aria-hidden="true">01</span>
              <div>
                <h3>¿Qué líquido vas a almacenar?</h3>
                <p>Para agua de riego, consumo humano o líquidos especiales pueden exigirse características distintas. Consulta la compatibilidad y la documentación del modelo.</p>
              </div>
            </li>
            <li class="guide__step">
              <span class="guide__step-num" aria-hidden="true">02</span>
              <div>
                <h3>¿Qué capacidad necesitas?</h3>
                <p>Valora el consumo y la autonomía que buscas. Los litros son solo el punto de partida: comprueba también las medidas y el espacio disponible.</p>
              </div>
            </li>
            <li class="guide__step">
              <span class="guide__step-num" aria-hidden="true">03</span>
              <div>
                <h3>¿Vertical, horizontal o enterrable?</h3>
                <p>El formato depende de la ubicación y las condiciones de apoyo. Para enterrar, elige únicamente una referencia diseñada específicamente para ello.</p>
              </div>
            </li>
            <li class="guide__step">
              <span class="guide__step-num" aria-hidden="true">04</span>
              <div>
                <h3>¿Cómo serán las conexiones y la entrega?</h3>
                <p>Revisa entradas y salidas, accesos y código postal. El transporte estándar no incluye la descarga: habrá que prever los medios adecuados.</p>
              </div>
            </li>
          </ol>

          <div class="guide__actions">
            <button class="guide__quote open-quote-trigger" type="button">
              <span>Consultar mi caso</span>
              <span class="guide__quote-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
              </span>
            </button>
            <a class="guide__explore" href="/depositos/">Comparar tipos de depósitos <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <aside class="guide__visual" aria-label="Formatos de depósitos de poliéster">
          <div class="guide__visual-heading">
            <span class="guide__visual-kicker">Formatos y configuraciones</span>
            <strong>Distintas formas para distintas necesidades</strong>
          </div>
          <img
            src="/images/productos/depositos-tipos.jpg"
            alt="Ilustración orientativa de depósitos de poliéster verticales y horizontales en diferentes configuraciones"
            loading="lazy"
            decoding="async"
            width="1478"
            height="1064"
          />
          <div class="guide__visual-foot">
            <a href="/depositos/">01 <strong>Verticales</strong><span aria-hidden="true">↗</span></a>
            <a href="/depositos/">02 <strong>Horizontales</strong><span aria-hidden="true">↗</span></a>
            <a href="/depositos/">03 <strong>Otros formatos</strong><span aria-hidden="true">↗</span></a>
          </div>
          <p class="guide__visual-caption">Ilustración orientativa. Las medidas, accesorios y configuraciones deben verificarse para cada referencia.</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 6 — PREGUNTAS FRECUENTES
       ═══════════════════════════════════════════════ -->
  <section class="faq section" id="preguntas-frecuentes" aria-labelledby="faq-heading">
    <div class="container">
      <div class="faq__layout">
        <div class="faq__intro">
          <span class="eyebrow">Preguntas frecuentes</span>
          <h2 class="heading-lg" id="faq-heading">Lo que necesitas saber antes de comprar</h2>
          <p class="body-lg">
            Aclaramos las dudas más habituales sobre depósitos de poliéster, capacidades,
            instalación y transporte. Información útil para elegir con criterio.
          </p>
        </div>

        <div class="faq__list" aria-label="Preguntas frecuentes sobre depósitos y transporte">
          <div class="faq__column">
          <details class="faq__item" name="depofibra-home-faq" open>
            <summary><span>¿Dónde comprar depósitos de poliéster para riego?</span></summary>
            <div class="faq__answer"><p>En Depofibra puedes consultar depósitos de poliéster reforzado con fibra de vidrio (PRFV), también llamados depósitos de fibra de vidrio, para riego y otros usos compatibles. Atendemos consultas desde Casariche (Sevilla); el suministro depende del modelo y del destino.</p></div>
          </details>
          <details class="faq__item" name="depofibra-home-faq">
            <summary><span>¿Qué depósito de agua elegir: 5.000, 10.000 o 15.000 litros?</span></summary>
            <div class="faq__answer"><p>La capacidad debe ajustarse al volumen de agua que necesitas almacenar. Además de los litros, compara diámetro, altura, base de apoyo, accesos y configuración de conexiones.</p></div>
          </details>
          <details class="faq__item" name="depofibra-home-faq">
            <summary><span>¿Qué diferencia hay entre un depósito vertical y uno horizontal?</span></summary>
            <div class="faq__answer"><p>El depósito vertical de base plana se instala en superficie sobre una base adecuada; el horizontal de superficie utiliza apoyos o cunas. La elección depende de la altura y superficie disponibles.</p></div>
          </details>
          <details class="faq__item" name="depofibra-home-faq">
            <summary><span>¿Puedo pedir precio con transporte incluido?</span></summary>
            <div class="faq__answer"><p>Sí. Indica la capacidad o el modelo, el uso previsto y la localidad con código postal. El coste del transporte se consulta según las dimensiones del depósito, el destino y los accesos.</p></div>
          </details>
          </div>
          <div class="faq__column">
          <details class="faq__item" name="depofibra-home-faq">
            <summary><span>¿Se puede enterrar un depósito de poliéster?</span></summary>
            <div class="faq__answer"><p>Solo si es un modelo expresamente previsto para enterramiento. Un depósito horizontal de superficie no debe instalarse bajo tierra sin una especificación técnica que lo autorice.</p></div>
          </details>
          <details class="faq__item" name="depofibra-home-faq">
            <summary><span>¿Todos los depósitos son aptos para agua potable?</span></summary>
            <div class="faq__answer"><p>No. Para almacenar agua destinada al consumo humano debes solicitar un modelo apto y documentación específica. No basta con que el material sea de poliéster.</p></div>
          </details>
          <details class="faq__item" name="depofibra-home-faq">
            <summary><span>¿El transporte incluye la descarga?</span></summary>
            <div class="faq__answer"><p>No. El transporte estándar no incluye la descarga. Antes de la entrega es necesario prever accesos y medios de descarga adecuados.</p></div>
          </details>
          <details class="faq__item" name="depofibra-home-faq">
            <summary><span>¿Depofibra entrega en España y Portugal?</span></summary>
            <div class="faq__answer"><p>Podemos estudiar suministros en España y Portugal según la referencia, el destino, el tamaño del producto y las condiciones del transporte. La viabilidad se confirma para cada solicitud.</p></div>
          </details>
          </div>
        </div>
          <div class="faq__help">
            <span class="faq__help-index">01 / 02</span>
            <p>¿Tu instalación tiene condiciones especiales? <strong>Cuéntanos tu caso.</strong></p>
            <button class="faq__help-link open-quote-trigger" type="button">
              Consultar mi caso
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
            </button>
          </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ═══════════════════════════════════════════════
     CAPACIDADES — Editorial + comparativa accesible
     ═══════════════════════════════════════════════ */
  .capacities {
    background: #fff;
    border-top: 1px solid var(--color-gray-200);
  }

  .capacities__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(34px, 4vw, 64px);
    align-items: start;
  }

  .capacities__intro { min-width: 0; }

  .capacities__intro .heading-lg {
    margin: 18px 0 20px;
    max-width: 650px;
    text-wrap: balance;
  }

  .capacities__intro .body-lg {
    max-width: 610px;
    margin-bottom: 22px;
    font-size: 16px;
    line-height: 1.8;
  }

  .capacities__intro strong { color: var(--color-dark); font-weight: 700; }

  .capacities__explore {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(1,72,142,.28);
    transition: border-color .22s ease;
  }

  .capacities__explore svg {
    width: 18px;
    height: 18px;
    transition: transform .25s ease;
  }
  .capacities__explore:hover { border-color: var(--color-primary); }
  .capacities__explore:hover svg { transform: translateX(4px); }

  .capacities__table { min-width: 0; border-top: 2px solid var(--color-primary); }

  .capacities__row {
    display: grid;
    grid-template-columns: minmax(0,1fr);
    gap: 10px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .capacities__amount { display: flex; flex-direction: column; gap: 5px; }
  .capacities__amount strong {
    display: block;
    color: var(--color-primary-dark);
    font: 800 clamp(24px,2vw,29px)/1.16 var(--font-display);
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .capacities__amount strong span { font: inherit; }
  .capacities__amount > span {
    color: var(--color-gray-500);
    font-size: 13px;
    line-height: 1.5;
  }
  .capacities__row p {
    margin: 0;
    max-width: 440px;
    color: var(--color-gray-600);
    font-size: 15px;
    line-height: 1.65;
  }

  .capacities__quote {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    width: max-content;
    min-height: 48px;
    padding: 12px 18px;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    color: var(--color-primary);
    background: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: background .25s ease, color .25s ease, transform .25s ease;
  }
  .capacities__quote svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    transition: transform .25s ease;
  }
  .capacities__quote:hover {
    background: var(--color-primary);
    color: #fff;
    transform: translateY(-2px);
  }
  .capacities__quote:hover svg { transform: translateX(4px) rotate(-20deg); }
  .capacities__quote:active { transform: translateY(0); }

  .capacities__note {
    margin: 17px 0 0;
    color: var(--color-gray-500);
    font-size: 13px;
    line-height: 1.7;
  }

  @media (min-width: 960px) {
    .capacities__layout {
      grid-template-columns: minmax(0, .83fr) minmax(0, 1.17fr);
      gap: clamp(42px,5vw,76px);
    }
    .capacities__row {
      grid-template-columns: minmax(136px,.64fr) minmax(145px,1fr);
      gap: 14px 20px;
    }
  }

  @media (min-width: 600px) and (max-width: 959px) {
    .capacities__row { grid-template-columns: minmax(140px,.55fr) minmax(0,1fr); gap: 14px 22px; }
  }

  /* Un único CTA, fuera de las filas, con espacio propio. */
  .capacities__table > .capacities__quote {
