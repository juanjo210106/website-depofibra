    }
    .logistics__details-intro {
      position: sticky;
      top: 105px;
      align-self: start;
      padding-bottom: 45px;
    }
    .logistics__progress { display: block; margin-top: 38px; }
    .logistics__progress-counter { display: flex; align-items: baseline; gap: 12px; margin-bottom: 20px; }
    .logistics__progress-counter strong {
      display: block;
      color: var(--color-primary-dark);
      font: 800 clamp(65px, 7vw, 100px)/.92 var(--font-display);
      letter-spacing: -.08em;
      font-variant-numeric: tabular-nums;
      transition: opacity .2s ease;
    }
    .logistics__progress-counter span { color: var(--color-gray-400); font: 700 15px/1 var(--font-display); }
    .logistics__progress-track { max-width: 215px; height: 3px; background: #d7e6f5; overflow: hidden; border-radius: 9px; }
    .logistics__progress-track span { display: block; width: 33.33%; height: 100%; background: var(--color-primary); transition: width .35s var(--ease-out); }
    .logistics__progress-caption { display: block; margin-top: 10px; font-size: 12px; color: var(--color-gray-500); }
    .logistics__steps { border-top: 0; }
    .logistics__steps li {
      min-height: 174px;
      grid-template-columns: minmax(90px, .29fr) minmax(0, 1fr);
      align-items: center;
      gap: 22px;
      padding: 23px 0;
      border-top: 1px solid var(--color-gray-200);
      border-bottom: 0;
      opacity: .73;
      transition: opacity .4s ease;
    }
    .logistics__steps li:last-child { border-bottom: 1px solid var(--color-gray-200); }
    .logistics__steps li.is-active { opacity: 1; }
    .logistics__steps li::before {
      content: '';
      position: absolute;
      top: -1px;
      left: 0;
      height: 2px;
      width: 0;
      background: var(--color-primary);
      transition: width .45s var(--ease-out);
    }
    .logistics__steps li.is-active::before { width: 80px; }
    .logistics__step-number {
      font-size: clamp(45px, 5vw, 70px);
      color: #a9c6e5;
      transition: color .4s ease, transform .5s var(--ease-out);
