  .guide__quote:hover { background: var(--color-primary-dark); transform: translateY(-1px); }
  .guide__quote:hover .guide__quote-icon { transform: translateX(2px) rotate(-12deg); background: rgba(255,255,255,.24); }
  .guide__explore {
    display: inline-flex;
    align-items: center;
